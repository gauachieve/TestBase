{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "stagingGateAccessKey": {
      "value": "${STAGING_GATE_ACCESS_KEY}"
    },
    "smsSenderId": {
      "value": "${SMS_SENDER_ID}"
    },
    "vonageApiKey": {
      "value": "${VONAGE_API_KEY}"
    },
    "vonageApiSecret": {
      "value": "${VONAGE_API_SECRET}"
    },
    "bankIdIduraAuthority": {
      "value": "${BANKID_IDURA_AUTHORITY}"
    },
    "bankIdIduraClientId": {
      "value": "${BANKID_IDURA_CLIENT_ID}"
    },
    "bankIdIduraClientSecret": {
      "value": "${BANKID_IDURA_CLIENT_SECRET}"
    }
  }
}
