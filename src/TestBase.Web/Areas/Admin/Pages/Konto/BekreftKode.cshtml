@page
@model TestBase.Web.Areas.Admin.Pages.Konto.BekreftKodeModel
@{
    ViewData["Title"] = "Bekreft kode";
}

<h1>Bekreft SMS-kode</h1>

<p>
    En 6-sifret kode er "sendt" til mobilnummeret ditt (mock — se konsollen der
    <code>dotnet watch run</code> kjører for den faktiske koden).
</p>

@if (Model.Feilmelding is not null)
{
    <p style="color: darkred;">@Model.Feilmelding</p>
}

<form method="post">
    <div>
        <label>Kode</label><br />
        <input asp-for="Kode" />
    </div>
    <button type="submit">Bekreft</button>
</form>
