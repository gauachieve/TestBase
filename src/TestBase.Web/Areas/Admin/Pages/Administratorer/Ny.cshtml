@page
@model TestBase.Web.Areas.Admin.Pages.Administratorer.NyModel
@{
    ViewData["Title"] = "Ny administrator";
}

<h1>Ny administrator</h1>

@if (Model.Feilmelding is not null)
{
    <p style="color: darkred;">@Model.Feilmelding</p>
}

<form method="post">
    <div><label>AdminId</label><br /><input asp-for="AdminId" required /></div>
    <div><label>Mobilnummer</label><br /><input asp-for="MobilNr" required /></div>
    <div><label>E-post</label><br /><input asp-for="Email" type="email" required /></div>
    <div><label>Fullt navn</label><br /><input asp-for="FulltNavn" required /></div>
    <div><label>Personnummer</label><br /><input asp-for="Personnummer" required /></div>
    <div><label>HPR-nummer</label><br /><input asp-for="HprNr" required /></div>
    <div>
        <label>Passord (valgfritt — sett kun i dev for å aktivere utviklingsmodus-pålogging for denne kontoen)</label><br />
        <input asp-for="Passord" type="password" />
    </div>
    <button type="submit">Opprett</button>
</form>
