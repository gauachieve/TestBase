@page "{id:long}"
@model TestBase.Web.Areas.Admin.Pages.Administratorer.RedigerModel
@{
    ViewData["Title"] = "Rediger administrator";
}

<h1>Rediger administrator</h1>

@if (Model.Feilmelding is not null)
{
    <p style="color: darkred;">@Model.Feilmelding</p>
}

<form method="post">
    <input type="hidden" asp-for="Id" />
    <div><label>AdminId</label><br /><input asp-for="AdminId" /></div>
    <div><label>Mobilnummer</label><br /><input asp-for="MobilNr" /></div>
    <div><label>E-post</label><br /><input asp-for="Email" /></div>
    <div><label>Fullt navn</label><br /><input asp-for="FulltNavn" /></div>
    <div><label>Personnummer</label><br /><input asp-for="Personnummer" /></div>
    <div><label>HPR-nummer</label><br /><input asp-for="HprNr" /></div>
    <div>
        <label>Nytt passord (valgfritt — la stå tomt for å beholde eksisterende)</label><br />
        <input asp-for="NyttPassord" type="password" />
    </div>
    <button type="submit">Lagre</button>
</form>

<p><a href="/Admin/Administratorer">Tilbake til administratorer</a></p>
