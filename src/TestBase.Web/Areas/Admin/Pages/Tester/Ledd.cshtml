@page "{id:long}"
@model TestBase.Web.Areas.Admin.Pages.Tester.LeddModel
@using TestBase.Shared.Domain.Tester
@{
    ViewData["Title"] = "Ledd";
}

<h1>Ledd for side: @Model.Side?.Navn</h1>

<table border="1" cellpadding="6" cellspacing="0">
    <thead>
        <tr>
            <th>Rekkefølge</th>
            <th>Spørsmål</th>
            <th>Svartype</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var ledd in Model.LeddListe)
    {
        <tr>
            <td>@ledd.Rekkefolge</td>
            <td>@ledd.Sporsmalstekst</td>
            <td>@ledd.Svartype</td>
        </tr>
    }
    </tbody>
</table>

<h2>Legg til ledd</h2>

@if (Model.Feilmelding is not null)
{
    <p style="color: darkred;">@Model.Feilmelding</p>
}

<form method="post">
    <div><label>Spørsmålstekst</label><br /><textarea asp-for="Sporsmalstekst" rows="2" cols="50"></textarea></div>
    <div><label>Instruksjon (valgfritt)</label><br /><textarea asp-for="Instruksjon" rows="2" cols="50"></textarea></div>
    <div>
        <label>Svartype</label><br />
        <select asp-for="Svartype" asp-items="Html.GetEnumSelectList<TestSvartype>()"></select>
    </div>
    <div>
        <label>
            Svaralternativer — påkrevd for Likert-skala: kommaseparerte "verdi:tekst"-par i
            visningsrekkefølge, f.eks. "5:Hele tiden,4:Det meste av tiden,...,0:Aldri"
        </label><br />
        <input asp-for="Svaralternativer" size="80" />
    </div>
    <button type="submit">Legg til ledd</button>
</form>

<p><a href="/Admin/Tester">Tilbake til tester</a></p>
