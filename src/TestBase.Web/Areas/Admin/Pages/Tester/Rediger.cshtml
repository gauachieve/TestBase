@page "{id:long}"
@model TestBase.Web.Areas.Admin.Pages.Tester.RedigerModel
@{
    ViewData["Title"] = "Rediger test";
}

<h1>Rediger test</h1>

@if (Model.TestKode is not null)
{
    <p><em>Dette er en innebygd test (kode: <code>@Model.TestKode</code>) — "Regenerer innebygde tester" oppretter kun manglende tester, og rører ikke disse feltene.</em></p>
}

@if (Model.Feilmelding is not null)
{
    <p style="color: darkred;">@Model.Feilmelding</p>
}

<form method="post">
    <input type="hidden" asp-for="Id" />
    <div><label>Navn</label><br /><input asp-for="Navn" /></div>
    <div><label>Beskrivelse / instruksjon (valgfritt)</label><br /><textarea asp-for="Beskrivelse" rows="3" cols="50"></textarea></div>
    <div><label>Belønningstekst ved fullføring (valgfritt)</label><br /><textarea asp-for="Belonningstekst" rows="2" cols="50"></textarea></div>
    <div><label><input asp-for="ErAktiv" type="checkbox" /> Aktiv (kan tildeles pasienter)</label></div>
    <button type="submit">Lagre</button>
</form>

<p><a href="/Admin/Tester/Sider/@Model.Id">Rediger sider</a> | <a href="/Admin/Tester">Tilbake til tester</a></p>
