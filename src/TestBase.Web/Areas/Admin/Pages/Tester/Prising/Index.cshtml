@page
@model TestBase.Web.Areas.Admin.Pages.Tester.Prising.IndexModel
@{
    ViewData["Title"] = "Testprising";
}

<h1>Testprising</h1>
<p>
    Minste/største pris er grenser på PASIENTENS TOTALPRIS (ikke bare behandlerens
    honorar) — minste pris 0 markerer at testen kan tilbys gratis. Klinikkandelen er
    nå en PROSENT av pasientens pris (ikke et flatt kronebeløp), og rettighetshaver-
    kostnaden er plattformens egen utgift (trekkes aldri fra pasienten direkte, men
    reduserer plattformens vist margin i Admin/Økonomi). Se docs/beslutningslogg.md
    "Abonnement/subscription-system".
</p>

@if (Model.Feilmelding is not null)
{
    <p style="color: darkred;">@Model.Feilmelding</p>
}

<form method="post" class="skjema-bred">
    <table border="1" cellpadding="6" cellspacing="0" class="prising-tabell">
        <thead>
            <tr>
                <th>Test</th>
                <th>Minste pris (NOK)</th>
                <th>Største pris (NOK)</th>
                <th>Typisk honorar (NOK)</th>
                <th>Minste klinikkandel (%)</th>
                <th>Rettighetshaver-kostnad per gjennomføring (NOK)</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var test in Model.Tester)
        {
            <tr>
                <td>@test.Navn</td>
                <td><input type="number" step="0.01" min="0" name="MinstePrisKr[@test.Id]" value="@test.MinstePrisKr.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="tall-input" /></td>
                <td><input type="number" step="0.01" min="0" name="StorstePrisKr[@test.Id]" value="@test.StorstePrisKr.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="tall-input" /></td>
                <td><input type="number" step="0.01" min="0" name="TypiskBehandlerHonorarKr[@test.Id]" value="@test.TypiskBehandlerHonorarKr.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="tall-input" /></td>
                <td><input type="number" step="0.01" min="0" max="100" name="MinstePartnerAndelProsent[@test.Id]" value="@test.MinstePartnerAndelProsent.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="tall-input" /></td>
                <td><input type="number" step="0.01" min="0" name="RettighetshaverKostnadKr[@test.Id]" value="@test.RettighetshaverKostnadKr.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="tall-input" /></td>
            </tr>
        }
        </tbody>
    </table>
    <p><button type="submit" class="btn-accent" data-disable-on-submit="Lagrer …">Lagre alle endringer</button></p>
</form>
