@page
@model TestBase.Web.Areas.Admin.Pages.Tester.Prising.IndexModel
@{
    ViewData["Title"] = "Testprising";
}

<h1>Testprising</h1>
<p>
    Minste/største pris er grenser på PASIENTENS TOTALPRIS (ikke bare behandlerens
    honorar) — minste pris 0 markerer at testen kan tilbys gratis. Se
    docs/beslutningslogg.md "Partner System + Test Monetization".
</p>

@if (Model.Feilmelding is not null)
{
    <p style="color: darkred;">@Model.Feilmelding</p>
}

<form method="post">
    <table border="1" cellpadding="6" cellspacing="0">
        <thead>
            <tr>
                <th>Test</th>
                <th>Minste pris (NOK)</th>
                <th>Største pris (NOK)</th>
                <th>Typisk behandler-honorar (NOK)</th>
                <th>Minste partnerandel (NOK)</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var test in Model.Tester)
        {
            <tr>
                <td>@test.Navn</td>
                <td><input type="number" step="0.01" min="0" name="MinstePrisKr[@test.Id]" value="@test.MinstePrisKr.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="tall-input" /> NOK</td>
                <td><input type="number" step="0.01" min="0" name="StorstePrisKr[@test.Id]" value="@test.StorstePrisKr.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="tall-input" /> NOK</td>
                <td><input type="number" step="0.01" min="0" name="TypiskBehandlerHonorarKr[@test.Id]" value="@test.TypiskBehandlerHonorarKr.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="tall-input" /> NOK</td>
                <td><input type="number" step="0.01" min="0" name="MinstePartnerAndelKr[@test.Id]" value="@test.MinstePartnerAndelKr.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="tall-input" /> NOK</td>
            </tr>
        }
        </tbody>
    </table>
    <p><button type="submit" class="btn-accent">Lagre alle endringer</button></p>
</form>
