@page
@model TestBase.Web.Areas.Admin.Pages.Tildel.TesterModel
@{
    ViewData["Title"] = "Tildel tester";
}

<h1>Tildel tester — steg 2: velg tester</h1>

@if (Model.Feilmelding is not null)
{
    <p style="color: darkred;">@Model.Feilmelding</p>
}

@if (Model.Resultat is not null)
{
    <h2>Tildeling fullført</h2>
    <ul>
    @foreach (var rad in Model.Resultat.PerPasient)
    {
        <li>
            <strong>@(rad.Navn ?? "(ikke fullført)")</strong> —
            @if (rad.SendtSms) { <text>SMS sendt. </text> }
            @if (rad.SendtEpost) { <text>E-post sendt. </text> }
            @if (!rad.SendtSms && !rad.SendtEpost) { <text>Ingen varsel sendt (mangler kontaktinfo).</text> }
            <ul>
            @foreach (var lenke in rad.Lenker)
            {
                <li>@lenke.TestNavn: <a href="@lenke.Lenke">@lenke.Lenke</a></li>
            }
            </ul>
        </li>
    }
    </ul>
    <p><a href="/Admin/Tildel/Pasienter">Tildel flere tester</a></p>
}
else if (Model.PlanlagtOpprettet)
{
    <h2>Utsending planlagt</h2>
    <p>Sendes @Model.PlanlagtTidspunktVisning?.ToString("g").</p>
    <p><a href="/Admin/Tildel/Pasienter">Tildel flere tester</a></p>
}
else if (Model.ValgtePasienter.Any())
{
    <p>Tildeler til: <strong>@string.Join(", ", Model.ValgtePasienter.Select(p => p.Pasient.Navn ?? "(ikke fullført)"))</strong></p>

    <form method="post" asp-page-handler="Send" id="tildelForm" data-disable-on-submit="Sender …">
        <input type="hidden" asp-for="PasientIderCsv" />

        <div>
            <label for="tildelTestSok">Søk i tester</label><br />
            <input type="search" id="tildelTestSok" data-tredfilter="#tildelKategoriTre" placeholder="Søk i testnavn …" />
        </div>

        <div class="tildel-med-info">
        <div class="tildel-kategori-tre" id="tildelKategoriTre">
        @foreach (var kategori in Model.KategoriTre)
        {
            <details open>
                <summary>@kategori.Kategori.Navn</summary>
                @if (!kategori.Tester.Any())
                {
                    <p><em>Ingen tester i denne kategorien ennå.</em></p>
                }
                else
                {
                    <ul>
                    @foreach (var test in kategori.Tester)
                    {
                        var visningsnavn = test.Navn + (string.IsNullOrEmpty(test.OversettelseNotat) ? "" : $" ({test.OversettelseNotat})");
                        <li data-sok="@visningsnavn.ToLowerInvariant()">
                            <label>
                                <input type="checkbox" name="TestIder" value="@test.Id" class="tildel-test-checkbox" data-test-id="@test.Id" data-test-navn="@visningsnavn"
                                       data-beskrivelse="@test.Beskrivelse"
                                       data-rapport-introduksjon="@test.RapportIntroduksjon"
                                       data-estimert-min="@Model.EstimertMinutterPerTestId.GetValueOrDefault(test.Id)"
                                       data-minste-pris="@test.MinstePrisKr.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       data-storste-pris="@test.StorstePrisKr.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       data-typisk-honorar="@test.TypiskBehandlerHonorarKr.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                @test.Navn
                                @if (!string.IsNullOrEmpty(test.OversettelseNotat))
                                {
                                    <em>(@test.OversettelseNotat)</em>
                                }
                            </label>
                        </li>
                    }
                    </ul>
                }
            </details>
        }
        </div>
        <aside class="test-infoboks skjult"></aside>
        </div>

        <button type="button" id="apneOppsummering" class="btn btn-accent">Gå til oppsummering</button>

        <partial name="_PlanleggingDialog" />

        <dialog id="oppsummeringDialog">
            <h2>Bekreft utsending</h2>

            <fieldset>
                <legend>Varslingsmetode for denne utsendingen</legend>
                <label><input type="radio" name="Varslingsmetode" value="Sms" class="tildel-varslingsmetode" /> SMS</label>
                <label><input type="radio" name="Varslingsmetode" value="Epost" class="tildel-varslingsmetode" /> E-post</label>
                <label><input type="radio" name="Varslingsmetode" value="Begge" class="tildel-varslingsmetode" checked /> Begge</label>
            </fieldset>

            <p>Du sender følgende tester:</p>
            <ul id="oppsummeringTester"></ul>
            <p id="oppsummeringPlanlegging" style="font-weight: bold;"></p>
            <p>til følgende pasienter:</p>
            <ul>
            @foreach (var p in Model.ValgtePasienter)
            {
                <li>@(p.Pasient.Navn ?? "(ikke fullført)")</li>
            }
            </ul>
            <button type="button" id="lukkOppsummering" class="btn btn-muted">Avbryt</button>
            <button type="submit" asp-page-handler="Send" class="btn btn-accent" id="sendNaaKnapp">Bekreft og send</button>
            <button type="submit" asp-page-handler="Planlegg" class="btn btn-accent" id="sendPlanlagtKnapp" hidden>Bekreft og planlegg</button>
        </dialog>
    </form>

    <script src="~/js/tildel.js" asp-append-version="true"></script>
    <script src="~/js/testinfo.js" asp-append-version="true"></script>
    <script src="~/js/testtre-filter.js" asp-append-version="true"></script>
}
else
{
    <p>Ingen gyldige pasienter valgt. <a href="/Admin/Tildel/Pasienter">Gå tilbake til steg 1</a>.</p>
}
