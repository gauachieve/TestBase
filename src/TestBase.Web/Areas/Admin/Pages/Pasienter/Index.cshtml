@page
@model TestBase.Web.Areas.Admin.Pages.Pasienter.IndexModel
@{
    ViewData["Title"] = "Pasienter";
}

<h1>Pasienter</h1>
<p>Alle pasienter på tvers av behandlere. Selve pasient-administrasjonen (legg til/rediger/arkiver/slett) skjer hos den enkelte behandler.</p>

@if (Model.ErSuperadmin)
{
    <p>
        @if (Model.VisSlettede)
        {
            <a href="/Admin/Pasienter">Skjul slettede</a>
        }
        else
        {
            <a href="/Admin/Pasienter?visSlettede=true">Vis slettede (kun Superadmin)</a>
        }
    </p>
}

<div>
    <label for="pasientSok">Søk</label><br />
    <input type="search" id="pasientSok" data-tabellfilter="#pasientTabell"
           placeholder="Søk i navn, behandler, gruppe, mobil, e-post, personnummer, status …" />
</div>

<table id="pasientTabell" border="1" cellpadding="6" cellspacing="0">
    <thead>
        <tr>
            <th>Navn</th>
            <th>Partner</th>
            <th>Behandler</th>
            <th>Gruppe</th>
            <th>Mobil</th>
            <th>E-post</th>
            <th>Personnummer</th>
            <th>Tildelt</th>
            <th>Besvart</th>
            <th>Status</th>
            @if (Model.VisSlettede)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
    @foreach (var rad in Model.Rader)
    {
        var p = rad.Pasient;
        var sok = $"{p.Navn} {rad.PartnerNavn} {rad.BehandlerNavn} {p.Gruppenavn} {p.MobilNr} {p.Email} {p.Personnummer} {p.Status}".ToLowerInvariant();
        <tr data-sok="@sok">
            <td>@(p.Navn ?? "(ikke fullført)")</td>
            <td>@(rad.PartnerNavn ?? "-")</td>
            <td>@(rad.BehandlerNavn ?? "-")</td>
            <td>@(p.Gruppenavn ?? "-")</td>
            <td>@p.MobilNr</td>
            <td>@p.Email</td>
            <td>@(p.Personnummer ?? "(ikke registrert ennå)")</td>
            <td>@rad.Tildelt</td>
            <td>@rad.Besvart</td>
            <td>@(p.ErSlettet ? "Slettet" : p.Status.ToString())</td>
            @if (Model.VisSlettede)
            {
                <td>
                    @if (p.ErSlettet)
                    {
                        <form method="post" asp-page-handler="GjenopprettFraSlettet" style="display:inline;">
                            <input type="hidden" name="id" value="@p.Id" />
                            <button type="submit" class="btn-icon" title="Gjenopprett" aria-label="Gjenopprett">
                                <partial name="_Ikon" model="@("gjenopprett")" />
                            </button>
                        </form>
                    }
                </td>
            }
        </tr>
    }
    </tbody>
</table>

<script src="~/js/tabellfilter.js" asp-append-version="true"></script>
