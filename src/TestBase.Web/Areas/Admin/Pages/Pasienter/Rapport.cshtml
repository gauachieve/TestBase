@page "{id:long}"
@model TestBase.Web.Areas.Admin.Pages.Pasienter.RapportModel
@using TestBase.Shared.Domain.Tester.Skaaring
@{
    ViewData["Title"] = "Rapport";
    var sidetall = 1;
}

<h1>Rapport: @(Model.Pasient?.Navn ?? "(ukjent pasient)")</h1>

@if (Model.IkkeGodkjentEnna)
{
    <p>Denne rapporten er ikke godkjent av behandler ennå.</p>
}
else
{
    <div class="rapport-verktoylinje" id="rapportVerktoylinje">
        <button type="button" id="rapportForrige">← Forrige</button>
        <span class="rapport-sideindikator" id="rapportSideindikator"></span>
        <button type="button" id="rapportNeste">Neste →</button>
    </div>

    <div class="rapport-dokument" id="rapportDokument">
        <section class="rapport-ark">
            <div class="rapport-hjornedekor"></div>

            <div class="rapport-tittelblokk">
                <span class="rapport-tittel-stor">Rapport</span>
                <span class="rapport-tittel-liten">@Model.Test?.Navn</span>
            </div>

            <div class="rapport-metarad">
                <div><strong>Fullført:</strong> @Model.Tildeling?.FullfortUtc?.ToString("g")</div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Test?.RapportIntroduksjon))
            {
                <p class="rapport-introduksjon">@Model.Test!.RapportIntroduksjon</p>
            }

            @if (Model.Skaaring is not null)
            {
                <div class="rapport-seksjon">
                    <span class="rapport-seksjon-tittel">Resultat</span>
                    @if (!Model.Skaaring.SkjulProsent)
                    {
                        <div class="rapport-skaarboks">
                            <div class="rapport-skaartall">@Model.Skaaring.ProsentSkaar %</div>
                            <div class="rapport-fremdrift">
                                <div class="rapport-fremdrift-fyll" style="width: @(Model.Skaaring.ProsentSkaar)%;"></div>
                                @foreach (var cutoff in Model.Cutoffs)
                                {
                                    <div class="rapport-cutoff-linje" style="left: @(cutoff.PosisjonProsent.ToString(System.Globalization.CultureInfo.InvariantCulture))%;" title="@cutoff.Navn"></div>
                                }
                            </div>
                        </div>
                        @if (Model.Cutoffs.Count > 0)
                        {
                            <p class="rapport-cutoff-forklaring">
                                @foreach (var cutoff in Model.Cutoffs)
                                {
                                    <span class="rapport-cutoff-label">▼ @cutoff.Navn</span>
                                }
                            </p>
                        }
                        <p>Råskår: <strong>@Model.Skaaring.RaaSkaar / @Model.Skaaring.RaaSkaarMaks</strong></p>
                    }
                    @if (Model.Skaaring.Indikatorer is { Count: > 0 })
                    {
                        <div class="rapport-indikatorer">
                        @foreach (var indikator in Model.Skaaring.Indikatorer)
                        {
                            <span class="rapport-indikator @(indikator.Positiv ? "rapport-indikator-positiv" : "rapport-indikator-negativ")">@indikator.Verdi</span>
                        }
                        </div>
                    }
                    <p class="rapport-fortolkning">@Model.Skaaring.Fortolkning</p>
                </div>
            }

            @if (Model.Sipp118Radar is not null)
            {
                <div class="rapport-seksjon">
                    <span class="rapport-seksjon-tittel">Domeneprofil</span>
                    @{
                        var radar = Model.Sipp118Radar;
                        string F(double tall) => tall.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                        string TekstTag(double x, double y, string ankerJustering, string innhold) =>
                            $"<text x=\"{F(x)}\" y=\"{F(y)}\" text-anchor=\"{ankerJustering}\" style=\"font-size: 11px; fill: var(--ink);\">{System.Net.WebUtility.HtmlEncode(innhold)}</text>";
                    }
                    <svg viewBox="0 0 @Sipp118RadarBeregner.Bredde @Sipp118RadarBeregner.Hoyde" role="img" aria-label="Domeneprofil (SIPP-118-inspirert)" style="max-width: 360px; display: block; margin: 0 auto;">
                        <polygon points="@radar.YtreRingPunkter" style="fill: none; stroke: var(--border); stroke-width: 1;" />
                        <polygon points="@radar.CutoffPolygonPunkter" style="fill: none; stroke: #c0392b; stroke-width: 1; stroke-dasharray: 4 3;" />
                        @foreach (var p in radar.Punkter)
                        {
                            <line x1="@F(radar.Senter)" y1="@F(radar.Senter)" x2="@F(p.X)" y2="@F(p.Y)" style="stroke: var(--border); stroke-width: 1;" />
                        }
                        <polygon points="@radar.DataPolygonPunkter" style="fill: var(--accent); fill-opacity: 0.28; stroke: var(--accent-dark); stroke-width: 2;" />
                        @foreach (var p in radar.Punkter)
                        {
                            <circle cx="@F(p.X)" cy="@F(p.Y)" r="3.5" style="fill: var(--accent-dark);" />
                            @Html.Raw(TekstTag(p.LabelX, p.LabelY, p.LabelAnker, $"{p.Navn} ({p.Verdi}/{p.Maks})"))
                        }
                    </svg>
                    <p style="font-size: 0.82rem; color: #666; text-align: center;">
                        Stiplet linje = forenklet lavfunksjon-grense (ikke en offisiell SIPP-118-norm). Viser kun DENNE besvarelsen.
                    </p>
                </div>
            }

            @if (Model.Scid5PfBar is not null)
            {
                <div class="rapport-seksjon">
                    <span class="rapport-seksjon-tittel">Personlighetsforstyrrelser — kriterieoversikt</span>
                    @if (Model.Scid5PfBar.VurderBlandetPf)
                    {
                        <div class="rapport-gyldighetsadvarsel" style="border: 1px solid #c90; background: #fff8e6; padding: 0.75rem 1rem; border-radius: 4px; margin-bottom: 0.75rem;">
                            <strong>Vurder Blandet personlighetsforstyrrelse:</strong> ingen enkelt forstyrrelse når sin egen
                            terskel, men samlet @Model.Scid5PfBar.TotaltAntall2 "Tydelig oppfylt"-kriterier på tvers av alle 10.
                            Dette er en EGEN, IKKE-offisiell tommelfingerregel (verken DSM-5 eller ICD-11 har en sitert
                            numerisk cutoff for "blandet"/uspesifisert personlighetsforstyrrelse) — klinisk skjønn avgjør.
                        </div>
                    }
                    @foreach (var stolpe in Model.Scid5PfBar.Stolper)
                    {
                        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.4rem;">
                            <div style="flex: 0 0 260px; font-size: 0.85rem; @(stolpe.TerskelNaadd ? "font-weight: 700;" : "")">@stolpe.Navn</div>
                            <div style="position: relative; width: @(Scid5PfBarBeregner.BarBredde.ToString(System.Globalization.CultureInfo.InvariantCulture))px; height: 1rem; border: 1px solid var(--border); background: #fff; flex: 0 0 auto;">
                                <div style="position: absolute; left: 0; top: 0; bottom: 0; width: @(stolpe.Segment2Bredde.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))px; background: var(--accent-dark);"></div>
                                <div style="position: absolute; left: @(stolpe.Segment2Bredde.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))px; top: 0; bottom: 0; width: @(stolpe.Segment1Bredde.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))px; background: var(--accent); opacity: 0.5;"></div>
                                <div title="Terskel: @stolpe.Terskel" style="position: absolute; top: -0.9rem; left: @(stolpe.CutoffX.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))px; transform: translateX(-50%); font-size: 0.7rem; color: #c0392b;">▼</div>
                            </div>
                            <div style="flex: 0 0 auto; font-size: 0.8rem; color: #555;">@stolpe.Antall2/@stolpe.Total (terskel @stolpe.Terskel)</div>
                        </div>
                    }
                    <p style="font-size: 0.82rem; color: #666;">
                        Mørk = "Tydelig oppfylt" (2), lys = "Delvis til stede" (1), hvit = "Fraværende" (0). ▼ markerer
                        kriterieterskelen. Fet skrift = forstyrrelsen når sin diagnostiske terskel.
                    </p>
                </div>
            }

            <div class="rapport-sidefot">@Model.Test?.Navn — side @sidetall av @Model.TotalAntallArk</div>
        </section>

        @for (var i = 0; i < Model.Sider.Count; i++)
        {
            sidetall++;
            var side = Model.Sider[i];
            <section class="rapport-ark">
                <div class="rapport-seksjon">
                    <span class="rapport-seksjon-tittel">Svar — @side.Side.Navn</span>
                    <table class="rapport-svartabell">
                        <thead><tr><th>Spørsmål</th><th>Svar</th></tr></thead>
                        <tbody>
                        @foreach (var rad in side.Svar)
                        {
                            <tr>
                                <td>
                                    @rad.Sporsmal
                                    @if (!string.IsNullOrWhiteSpace(rad.BehandlerKommentar))
                                    {
                                        <br /><em style="color: #666; font-size: 0.9em;">Kommentar: @rad.BehandlerKommentar</em>
                                    }
                                </td>
                                <td>@rad.SvarLabel</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="rapport-sidefot">@Model.Test?.Navn — side @sidetall av @Model.TotalAntallArk</div>
            </section>
        }
    </div>

    <div class="rapport-handlinger">
        <button type="button" id="rapportSkrivUtKnapp" class="btn btn-accent btn-sm">Skriv ut</button>
    </div>

    <script src="~/js/rapport.js" asp-append-version="true"></script>
}

<p><a href="/Admin/Pasienter/GodkjenteRapporter/@Model.Pasient?.Id">Tilbake til godkjente rapporter</a></p>
