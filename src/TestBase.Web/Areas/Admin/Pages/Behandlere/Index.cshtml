@page
@model TestBase.Web.Areas.Admin.Pages.Behandlere.IndexModel
@using TestBase.Shared.Domain.Administrasjon
@{
    ViewData["Title"] = "Behandlere";
}

<h1>Behandlere</h1>
<p><a href="/Admin/Behandlere/Inviter">+ Inviter ny behandler</a></p>

@if (Model.Feilmelding is not null)
{
    <p style="color: darkred;">@Model.Feilmelding</p>
}

@if (Model.ErSuperadmin)
{
    <p>
        @if (Model.VisSlettede)
        {
            <a href="/Admin/Behandlere">Skjul slettede</a>
        }
        else
        {
            <a href="/Admin/Behandlere?visSlettede=true">Vis slettede (kun Superadmin)</a>
        }
    </p>
}

<table border="1" cellpadding="6" cellspacing="0">
    <thead>
        <tr>
            <th>Navn</th>
            <th>E-post</th>
            <th>Mobil</th>
            <th>Personnummer</th>
            <th>HPR-nr</th>
            <th>HPR-status</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var b in Model.Behandlere)
    {
        <tr>
            <td>@(b.Visningsnavn ?? "(ikke fullført)")</td>
            <td>@b.Email</td>
            <td>@b.MobilNr</td>
            <td>@(b.Personnummer ?? "-")</td>
            <td>@(b.HprNr ?? "-")</td>
            <td>
                @if (b.HprGodkjent)
                {
                    <text>Godkjent @b.HprGodkjentUtc?.ToString("d")</text>
                }
                else if (b.RegistrertUtc is null)
                {
                    <text>Ikke registrert ennå</text>
                }
                else
                {
                    <text>Venter — frist @b.RegistrertUtc.Value.AddDays(7).ToString("d")</text>
                }
            </td>
            <td>@(b.ErSlettet ? "Slettet" : b.Status.ToString())</td>
            <td>
                @if (b.ErSlettet)
                {
                    <form method="post" asp-page-handler="GjenopprettFraSlettet" style="display:inline;">
                        <input type="hidden" name="id" value="@b.Id" />
                        <button type="submit" class="btn-icon" title="Gjenopprett" aria-label="Gjenopprett">
                            <partial name="_Ikon" model="@("gjenopprett")" />
                        </button>
                    </form>
                }
                else
                {
                    <a class="btn-icon" href="/Admin/Behandlere/Rediger/@b.Id" title="Rediger" aria-label="Rediger">
                        <partial name="_Ikon" model="@("rediger")" />
                    </a>
                    @if (b.Status != BehandlerStatus.Arkivert)
                    {
                        var frysTittel = b.Status == BehandlerStatus.Fryst ? "Gjenåpne" : "Frys";
                        <form method="post" asp-page-handler="Frys" style="display:inline;">
                            <input type="hidden" name="id" value="@b.Id" />
                            <button type="submit" class="btn-icon" title="@frysTittel" aria-label="@frysTittel">
                                <partial name="_Ikon" model="@(b.Status == BehandlerStatus.Fryst ? "gjenaapne" : "frys")" />
                            </button>
                        </form>
                        <form method="post" asp-page-handler="Arkiver" style="display:inline;">
                            <input type="hidden" name="id" value="@b.Id" />
                            <button type="submit" class="btn-icon" title="Arkiver" aria-label="Arkiver">
                                <partial name="_Ikon" model="@("arkiver")" />
                            </button>
                        </form>
                        @if (b.RegistrertUtc is not null)
                        {
                            var godkjennTittel = b.HprGodkjent ? "Tilbakekall HPR-godkjenning" : "Godkjenn HPR";
                            <form method="post" asp-page-handler="GodkjennHpr" style="display:inline;">
                                <input type="hidden" name="id" value="@b.Id" />
                                <button type="submit" class="btn-icon" title="@godkjennTittel" aria-label="@godkjennTittel">
                                    <partial name="_Ikon" model="@(b.HprGodkjent ? "tilbakekall" : "godkjenn")" />
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Slett" style="display:inline;"
                              data-captcha-sporsmal="@Model.CaptchaSporsmal"
                              onsubmit="return bekreftSletting(this, 'behandleren @b.Visningsnavn')">
                            <input type="hidden" name="id" value="@b.Id" />
                            <input type="hidden" asp-for="CaptchaSignertFasit" />
                            <input type="hidden" name="CaptchaSvar" />
                            <button type="submit" class="btn-icon btn-icon--slett" title="Slett" aria-label="Slett">
                                <partial name="_Ikon" model="@("slett")" />
                            </button>
                        </form>
                    }
                }
            </td>
        </tr>
    }
    </tbody>
</table>
