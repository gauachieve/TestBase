@page
@model TestBase.Web.Areas.Admin.Pages.Partnere.IndexModel
@{
    ViewData["Title"] = "Partnere";
}

<h1>Partnere</h1>
<p><a class="btn btn-accent" href="/Admin/Partnere/Ny">+ Ny partner</a></p>

@if (Model.Feilmelding is not null)
{
    <p style="color: darkred;">@Model.Feilmelding</p>
}

<p>
    @if (Model.VisSlettede)
    {
        <a class="btn btn-outline btn-sm" href="/Admin/Partnere">Skjul slettede</a>
    }
    else
    {
        <a class="btn btn-outline btn-sm" href="/Admin/Partnere?visSlettede=true">Vis slettede</a>
    }
</p>

<div data-flervalg-beholder>
    <div data-flervalg-verktoylinje hidden style="margin: 0.75rem 0;">
        <strong><span data-flervalg-antall>0</span> valgt</strong>
        <button type="submit" form="partnerFlervalgSkjema" asp-page-handler="ArkiverValgte" class="btn btn-outline" data-disable-on-submit="Arkiverer …">
            <partial name="_Ikon" model="@("arkiver")" /> Arkiver valgte
        </button>
    </div>
    <form id="partnerFlervalgSkjema" method="post"></form>

<table border="1" cellpadding="6" cellspacing="0">
    <thead>
        <tr>
            <th><input type="checkbox" data-flervalg-alle aria-label="Velg alle" /></th>
            <th>Navn</th>
            <th>Kontaktperson</th>
            <th>Abonnement</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model.Partnere)
    {
        <tr>
            <td>
                @if (!p.ErSlettet && !p.ErArkivert)
                {
                    <input type="checkbox" name="partnerId" value="@p.Id" form="partnerFlervalgSkjema" data-flervalg-rad aria-label="Velg @p.Navn" />
                }
            </td>
            <td>@p.Navn</td>
            <td>@(p.KontaktpersonNavn ?? "-")</td>
            <td>@(p.HarAktivtAbonnement ? "Aktivt" : "Ingen")</td>
            <td>@(p.ErSlettet ? "Slettet" : p.ErArkivert ? "Arkivert" : "Aktiv")</td>
            <td>
                @if (p.ErSlettet)
                {
                    <form method="post" asp-page-handler="GjenopprettFraSlettet" style="display:inline;" data-disable-on-submit="Gjenoppretter …">
                        <input type="hidden" name="id" value="@p.Id" />
                        <button type="submit" class="btn-icon" title="Gjenopprett" aria-label="Gjenopprett">
                            <partial name="_Ikon" model="@("gjenopprett")" />
                        </button>
                    </form>
                }
                else
                {
                    <a class="btn-icon btn-icon--partner" href="/Admin/Partnere/Rediger/@p.Id" title="Rediger" aria-label="Rediger">
                        <partial name="_Ikon" model="@("rediger")" />
                    </a>
                    <a class="btn-icon btn-icon--partner" href="/Admin/Partnere/Tester/@p.Id" title="Tester" aria-label="Tester">
                        <partial name="_Ikon" model="@("tester")" />
                    </a>
                    <form method="post" asp-page-handler="Arkiver" style="display:inline;" data-disable-on-submit="Lagrer …">
                        <input type="hidden" name="id" value="@p.Id" />
                        <button type="submit" class="btn-icon" title="@(p.ErArkivert ? "Gjenopprett" : "Arkiver")" aria-label="@(p.ErArkivert ? "Gjenopprett" : "Arkiver")">
                            <partial name="_Ikon" model="@(p.ErArkivert ? "gjenopprett" : "arkiver")" />
                        </button>
                    </form>
                    <form method="post" asp-page-handler="Slett" style="display:inline;"
                          data-captcha-sporsmal="@Model.CaptchaSporsmal"
                          onsubmit="return bekreftSletting(this, 'partneren @p.Navn')">
                        <input type="hidden" name="id" value="@p.Id" />
                        <input type="hidden" asp-for="CaptchaSignertFasit" />
                        <input type="hidden" name="CaptchaSvar" />
                        <button type="submit" class="btn-icon btn-icon--slett" title="Slett" aria-label="Slett" disabled="@(!p.ErArkivert)">
                            <partial name="_Ikon" model="@("slett")" />
                        </button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

<script src="~/js/flervalg.js" asp-append-version="true"></script>
