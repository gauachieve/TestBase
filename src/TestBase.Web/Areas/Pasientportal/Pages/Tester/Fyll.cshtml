@page "{id:long}/{side:int?}"
@model TestBase.Web.Areas.Pasientportal.Pages.Tester.FyllModel
@using TestBase.Shared.Domain.Tester
@{
    ViewData["Title"] = "Fyll ut test";
}

@if (TempData["GyldighetsAdvarselForrigeTest"] is string forrigeAdvarsel)
{
    <div style="border: 1px solid #c90; background: #fff8e6; padding: 1rem; border-radius: 4px; margin-bottom: 1rem;">
        <p><strong>Merk om forrige test:</strong> @forrigeAdvarsel</p>
    </div>
}

@if (Model.Innhold is null)
{
    <p style="color: darkred;">Fant ikke testen.</p>
}
else if (Model.ErFullfort)
{
    <h1>@(Model.Innhold.Test.BelonningsTittel ?? "Ferdig!")</h1>
    <p>@(Model.Innhold.Test.Belonningstekst ?? "Takk for at du fylte ut testen.")</p>
    @if (Model.GyldighetsAdvarsel is not null)
    {
        <div style="border: 1px solid #c90; background: #fff8e6; padding: 1rem; border-radius: 4px; margin: 1rem 0;">
            <p><strong>Merk:</strong> Du hoppet over noen spørsmål, så resultatet er mindre sikkert enn vanlig — svarene dine er likevel sendt inn, og behandleren din vil se denne merknaden på rapporten.</p>
        </div>
    }
    @if (Model.Innhold.Tildeling.RapportGodkjentUtc is not null && Model.Innhold.Tildeling.RapportSynligForPasient)
    {
        <p><a class="btn-accent" href="/Pasientportal/Tester/Rapport/@Model.Innhold.Tildeling.Id">Se rapporten din</a></p>
    }
    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1rem;">
        @if (Model.NesteIkkeFullforteTildelingId is not null)
        {
            var nesteTekst = "Ferdigstill og videre til " + (Model.NesteIkkeFullforteTestNavn ?? "neste test");
            <a class="btn-accent" href="/Pasientportal/Tester/Fyll/@Model.NesteIkkeFullforteTildelingId">@nesteTekst</a>
        }
        <a class="btn-accent" href="/Pasientportal/MinSide">Ferdigstill og tilbake til Min Side</a>
    </div>
}
else
{
    var totalSider = Model.Innhold.Sider.Count;
    var fremdriftProsent = totalSider == 0 ? 0 : (Model.GjeldendeSideNummer - 1) * 100 / totalSider;

    <h1>@Model.Innhold.Test.Navn</h1>
    <p>Side @Model.GjeldendeSideNummer av @totalSider</p>
    <div style="border: 1px solid #ccc; width: 100%; height: 1rem;">
        <div style="background: #4a4; width: @(fremdriftProsent)%; height: 100%;"></div>
    </div>

    @if (Model.GjeldendeSideNummer == 1 && !string.IsNullOrWhiteSpace(Model.Innhold.Test.Beskrivelse))
    {
        <p class="test-intro"><em>@Model.Innhold.Test.Beskrivelse</em></p>
    }

    @if (Model.GjeldendeSide is not null)
    {
        <h2>@Model.GjeldendeSide.Navn</h2>
        @if (!string.IsNullOrWhiteSpace(Model.GjeldendeSide.Instruksjon))
        {
            <p><em>@Model.GjeldendeSide.Instruksjon</em></p>
        }

        <form method="post" data-disable-on-submit="Lagrer svar …">
            @foreach (var ledd in Model.LeddPaaGjeldendeSide)
            {
                var eksisterende = Model.Innhold.EksisterendeSvar.GetValueOrDefault(ledd.Id);
                <div style="margin-bottom: 1.5rem;">
                    <p><strong>@ledd.Sporsmalstekst</strong>@(ledd.ErPaakrevd ? " *" : "")</p>
                    @if (!string.IsNullOrWhiteSpace(ledd.Instruksjon))
                    {
                        <p><em>@ledd.Instruksjon</em></p>
                    }

                    @if (ledd.Svartype == TestSvartype.LikertSkala)
                    {
                        // PDS-ICD-11 sine svaralternativer er lange nok til at radlayout blir
                        // trangt — stables vertikalt som fullbredde-bokser i stedet (bugliste
                        // 2026-09-13 punkt 24, utvidet 2026-09-20 til PDS-ICD-11), uten å røre
                        // andre testers kortere alternativer. MADRS-S fikk i stedet en EGEN
                        // layout (bugliste punkt 3, 2026-10-04): stablet vertikalt så "over
                        // hverandre"-mellomtrinnene (f.eks. "2" uten egen tekst mellom "0" og
                        // "4") ble visuelt utydelige — store, horisontale runde knapper med
                        // tiltet tekst (45°) over hver, à la et diagram sin akseetikett, holder
                        // alle seks gradene synlige side om side i stedet.
                        var stablet = Model.Innhold.Test.Kode is "pds_icd11";
                        var tiltetTekst = Model.Innhold.Test.Kode is "madrs_s";

                        // PDS-ICD-11 ledd 1-10 er bipolare og stokkes i visningsrekkefølge —
                        // den "sunne" midtre teksten som alltid ligger i midten er kun en
                        // konvensjon fra papirversjonen, ikke klinisk meningsbærende (se
                        // TestLeddSvaralternativer.ParseStokket). Ledd 11-14 (Rekkefolge >
                        // 10, samme test) har en reell, økende alvorlighetsrekkefølge og
                        // beholder derfor sin faste rekkefølge. Frøet kombinerer tildelings-
                        // og ledd-id slik at rekkefølgen er stabil for ÉN besvarelse, men
                        // varierer mellom ulike pasienter.
                        var stokkes = Model.Innhold.Test.Kode == "pds_icd11" && ledd.Rekkefolge <= 10;
                        var punkter = stokkes
                            ? TestLeddSvaralternativer.ParseStokket(ledd.Svaralternativer, unchecked((int)(Model.Innhold.Tildeling.Id * 397 ^ ledd.Id)))
                            : TestLeddSvaralternativer.Parse(ledd.Svaralternativer);
                        <div class="svar-rad @(stablet ? "svar-rad--stablet" : "") @(tiltetTekst ? "svar-rad--tiltet-tekst" : "")">
                        @foreach (var punkt in punkter)
                        {
                            <label class="svar-knapp">
                                <input type="radio" name="Svar_@ledd.Id" value="@punkt.Verdi" checked="@(eksisterende == punkt.Verdi.ToString())" />
                                <span>@punkt.Tekst</span>
                            </label>
                        }
                        </div>
                    }
                    else if (ledd.Svartype == TestSvartype.VisuellAnalogSkala)
                    {
                        var endepunkter = TestLeddSvaralternativer.Parse(ledd.Svaralternativer);
                        var lavEndepunkt = endepunkter.OrderBy(p => p.Verdi).FirstOrDefault();
                        var hoyEndepunkt = endepunkter.OrderByDescending(p => p.Verdi).FirstOrDefault();
                        <div class="vas-glidebryter">
                            <input type="range" class="vas-slider" min="0" max="100" name="Svar_@ledd.Id" value="@(eksisterende ?? "50")" />
                            <div class="vas-endepunkter">
                                <span>@(lavEndepunkt?.Tekst ?? "0")</span>
                                <span>@(hoyEndepunkt?.Tekst ?? "100")</span>
                            </div>
                        </div>
                    }
                    else if (ledd.Svartype == TestSvartype.JaNei)
                    {
                        <div class="svar-rad">
                            <label class="svar-knapp">
                                <input type="radio" name="Svar_@ledd.Id" value="Ja" checked="@(eksisterende == "Ja")" />
                                <span>Ja</span>
                            </label>
                            <label class="svar-knapp">
                                <input type="radio" name="Svar_@ledd.Id" value="Nei" checked="@(eksisterende == "Nei")" />
                                <span>Nei</span>
                            </label>
                        </div>
                    }
                    else if (ledd.Svartype == TestSvartype.Bilde)
                    {
                        // Rent visningsinnhold forfatteren (behandleren) la inn — ALDRI et
                        // spørsmål/svar, derfor intet name="Svar_..."-attributt her.
                        if (!string.IsNullOrEmpty(ledd.BildeData))
                        {
                            <img src="data:@(ledd.BildeContentType ?? "image/jpeg");base64,@ledd.BildeData"
                                 alt="@ledd.Sporsmalstekst" style="border-radius: 8px;"
                                 onclick="this.classList.toggle('bilde-utvidet')" class="hjemmeoppgave-bilde" />
                        }
                        @if (!string.IsNullOrWhiteSpace(ledd.BildeUrl))
                        {
                            <p><a href="@ledd.BildeUrl" target="_blank" rel="noopener noreferrer">@ledd.BildeUrl</a></p>
                        }
                    }
                    else if (ledd.Svartype == TestSvartype.Url)
                    {
                        <input type="url" name="Svar_@ledd.Id" value="@eksisterende" placeholder="https://…" style="width: 100%; max-width: 480px;" />
                    }
                    else
                    {
                        <textarea name="Svar_@ledd.Id" rows="3" cols="50">@eksisterende</textarea>
                    }
                </div>
            }

            @if (Model.ManglendePaakrevdeSvar.Count > 0)
            {
                <div style="border: 1px solid #c00; background: #fee; padding: 1rem; border-radius: 4px; margin-bottom: 1rem;">
                    <p><strong>Du må svare på følgende før du kan levere inn:</strong></p>
                    <ul>
                    @foreach (var sporsmal in Model.ManglendePaakrevdeSvar)
                    {
                        <li>@sporsmal</li>
                    }
                    </ul>
                </div>
            }

            <div>
                @if (Model.GjeldendeSideNummer > 1)
                {
                    <button type="submit" name="Handling" value="Forrige">Forrige</button>
                }
                @if (Model.GjeldendeSideNummer < totalSider)
                {
                    <button type="submit" name="Handling" value="Neste">Neste</button>
                }
                else if (Model.NesteIkkeFullforteTildelingId is not null)
                {
                    // To direkte handlinger i stedet for én knapp + en ekstra "Ferdig!"-
                    // bekreftelsesside (bugliste punkt 1) — pasienten velger selv om de vil
                    // rett videre til neste test, eller stoppe her og dra tilbake til Min
                    // Side, uten et redundant mellomsteg som bare gjentar samme spørsmål.
                    <button type="submit" name="Handling" value="FerdigNeste" class="btn-accent">Fullfør og gå videre til @(Model.NesteIkkeFullforteTestNavn ?? "neste test")</button>
                    <button type="submit" name="Handling" value="FerdigHjem">Fullfør og gå tilbake til Min Side</button>
                }
                else
                {
                    <button type="submit" name="Handling" value="Ferdig" class="btn-accent">Fullfør og gå til Min Side</button>
                }
            </div>
        </form>

        @if (Model.ProgramDeltakelseId is not null)
        {
            <div style="margin-top: 2rem; border-top: 1px solid #ddd; padding-top: 1rem;">
                <p><em>Denne testen er en del av et program.</em></p>
                <button type="button" class="btn-muted" onclick="document.getElementById('programValgDialog').showModal()">Pause eller meld meg ut av programmet</button>
            </div>

            <dialog id="programValgDialog">
                <h2>Programmet ditt</h2>
                <p><strong>Pause:</strong> du får ingen flere påminnelser midlertidig, men programmet fortsetter der det var når du selv ønsker å fortsette (be behandleren din om å gjenoppta det for deg).</p>
                <p><strong>Meld meg ut:</strong> du får ALDRI flere påminnelser fra dette programmet igjen. Testen du er i gang med nå blir ikke påvirket.</p>
                <form method="post" asp-page-handler="PauseProgram" style="display: inline;">
                    <input type="hidden" name="id" value="@Model.Innhold!.Tildeling.Id" />
                    <input type="hidden" name="deltakelseId" value="@Model.ProgramDeltakelseId" />
                    <button type="submit">Pause</button>
                </form>
                <form method="post" asp-page-handler="MeldUtProgram" style="display: inline;" onsubmit="return confirm('Sikker på at du vil melde deg helt ut av programmet? Dette kan ikke angres selv.');">
                    <input type="hidden" name="id" value="@Model.Innhold!.Tildeling.Id" />
                    <input type="hidden" name="deltakelseId" value="@Model.ProgramDeltakelseId" />
                    <button type="submit" class="btn-muted">Meld meg ut</button>
                </form>
                <button type="button" class="btn-muted" onclick="document.getElementById('programValgDialog').close()">Avbryt</button>
            </dialog>
        }
    }
}
