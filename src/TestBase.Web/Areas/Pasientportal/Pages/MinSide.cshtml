@page
@model TestBase.Web.Areas.Pasientportal.Pages.MinSideModel
@using TestBase.Shared.Domain.Tester
@{
    ViewData["Title"] = "Min side";
}

@{
    var antallUbesvarte = Model.Tildelinger.Count(t => t.Tildeling.Status != TestTildelingStatus.Fullfort);
}
<h1>Min side @(antallUbesvarte > 0 ? $"({antallUbesvarte})" : "")</h1>

@if (Model.Feilmelding is not null)
{
    <p style="color: darkred;">@Model.Feilmelding</p>
}

@if (!Model.Tildelinger.Any())
{
    <p>Du har ingen tildelte tester ennå.</p>
}
else
{
    <p>@(antallUbesvarte > 0 ? $"Du har {antallUbesvarte} test(er) som venter på svar." : "Alle tildelte tester er besvart.")</p>
    <table border="1" cellpadding="6" cellspacing="0">
        <thead>
            <tr>
                <th>Test</th>
                <th>Status</th>
                <th>Tildelt</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var rad in Model.Tildelinger)
        {
            <tr>
                <td>@rad.TestNavn</td>
                <td>@rad.Tildeling.Status</td>
                <td>@rad.Tildeling.TildeltUtc.ToString("d")</td>
                <td>
                    @if (rad.Tildeling.Status != TestTildelingStatus.Fullfort)
                    {
                        <a href="/Pasientportal/Tester/Fyll/@rad.Tildeling.Id">
                            @(rad.Tildeling.Status == TestTildelingStatus.Startet ? "Fortsett" : "Start")
                        </a>
                    }
                    else
                    {
                        <text>Fullført @rad.Tildeling.FullfortUtc?.ToString("d")</text>
                        @if (rad.Tildeling.RapportGodkjentUtc is not null && rad.Tildeling.RapportSynligForPasient)
                        {
                            <text> — </text>
                            <a href="/Pasientportal/Tester/Rapport/@rad.Tildeling.Id">Se rapport</a>
                        }
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<h2>Slett min konto</h2>
<p>Dette arkiverer og skjuler kontoen din umiddelbart, og logger deg ut. Kun Superadmin kan gjenopprette den etterpå.</p>
<form method="post" asp-page-handler="SlettMinKonto"
      data-captcha-sporsmal="@Model.CaptchaSporsmal"
      onsubmit="return bekreftSletting(this, 'din egen pasientkonto')">
    <input type="hidden" asp-for="CaptchaSignertFasit" />
    <input type="hidden" name="CaptchaSvar" />
    <button type="submit" class="btn-icon btn-icon--slett" style="width:auto;padding:0 1rem;">Slett min konto</button>
</form>
