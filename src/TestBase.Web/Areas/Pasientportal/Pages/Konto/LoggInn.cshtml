@page
@model TestBase.Web.Areas.Pasientportal.Pages.Konto.LoggInnModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "Logg inn som pasient";
    ViewData["Portal"] = "pasient";
}

<h1>Logg inn som pasient</h1>

@if (Model.Feilmelding is not null)
{
    <p style="color: darkred;">@Model.Feilmelding</p>
}

<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div><label><input asp-for="HuskMeg" type="checkbox" /> Husk meg</label></div>
    @if (Env.IsDevelopment())
    {
        <div>
            <label>Personnummer (kun utviklingsmiljø — overstyrer BankID-mock, bytt for å logge inn som en annen test-pasient)</label><br />
            <input asp-for="PersonnummerOverride" autocomplete="off" placeholder="La stå tomt for fast test-personnummer" />
        </div>
    }
    <div>
        <label>@Model.CaptchaSporsmal</label><br />
        <input asp-for="CaptchaSvar" autocomplete="off" inputmode="numeric" />
        <input type="hidden" asp-for="CaptchaSignertFasit" />
    </div>
    <button type="submit">Logg inn med BankID</button>
</form>

<p>
    Pasienter logger inn med BankID (mock — ingen ekte BankID kontaktes i dev). Har du ikke
    fullført registreringen ennå, bruk lenken du mottok fra din behandler.
</p>
