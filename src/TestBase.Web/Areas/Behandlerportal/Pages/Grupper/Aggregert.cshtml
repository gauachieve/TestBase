@page "{id:long}"
@model TestBase.Web.Areas.Behandlerportal.Pages.Grupper.AggregertModel
@{
    ViewData["Title"] = Model.TestId is not null ? "Gruppe­rapport" : "Aggregert rapport";
}

@if (Model.TestId is not null)
{
    <h1>@(Model.Enkelttest?.Tittel ?? "Gruppe­rapport")</h1>
    <p>
        <a href="/Behandlerportal/Grupper/Rediger/@Model.Id">Tilbake til gruppen</a>
        &nbsp;|&nbsp;
        <a href="/Behandlerportal/Grupper/Aggregert/@Model.Id">◂ Tilbake til oversikt (alle tester)</a>
    </p>

    @if (Model.Feilmelding is not null)
    {
        <p style="color: darkred;">@Model.Feilmelding</p>
    }
    else if (Model.Enkelttest is null)
    {
        <p><em>Fant ikke denne testen på gruppen.</em></p>
    }
    else
    {
        var d = Model.Enkelttest.Detaljer;
        <p>@(Model.Enkelttest.Provedata ? "Prøvedata" : "Ekte pasienter") — @Model.Enkelttest.Fra.ToString("dd.MM.yyyy") til @Model.Enkelttest.Til.ToString("dd.MM.yyyy")</p>

        @if (d.AntallFullfort == 0)
        {
            <p><em>Ingen fullførte besvarelser i det valgte intervallet.</em></p>
        }
        else
        {
            var enhet = d.VisSomProsent ? "%" : "";
            var maksSuffiks = d.VisSomProsent ? "" : $" (av {d.SkalaMaks})";
            var gjennomsnittEtikett = "Gjennomsnitt" + maksSuffiks;
            var medianEtikett = "Median" + maksSuffiks;
            <div class="rapport-stat-grid">
                <div class="rapport-stat-tile"><div class="rapport-stat-verdi">@d.AntallFullfort</div><div class="rapport-stat-etikett">Antall deltakere</div></div>
                <div class="rapport-stat-tile"><div class="rapport-stat-verdi">@(d.Gjennomsnitt?.ToString("0.0"))@enhet</div><div class="rapport-stat-etikett">@gjennomsnittEtikett</div></div>
                <div class="rapport-stat-tile"><div class="rapport-stat-verdi">@(d.Median?.ToString("0.0"))@enhet</div><div class="rapport-stat-etikett">@medianEtikett</div></div>
                <div class="rapport-stat-tile"><div class="rapport-stat-verdi">@(d.Standardavvik?.ToString("0.0"))@enhet</div><div class="rapport-stat-etikett">Standardavvik</div></div>
            </div>

            <h2>Spredning</h2>
            <p><em>@(d.VisSomProsent ? "Antall deltakere per 10 %-intervall av prosentskår." : $"Antall deltakere per skår-intervall (råskår, maks {d.SkalaMaks}).")</em></p>
            @if (Model.Plott.Count == 0)
            {
                <p><em>Ingen data å vise spredning for.</em></p>
            }
            else
            {
                <svg class="rapport-histogram" viewBox="0 0 560 220" role="img" aria-label="Histogram over antall deltakere per skår-intervall">
                    @foreach (var soyle in Model.Plott)
                    {
                        <rect x="@soyle.X.ToString(System.Globalization.CultureInfo.InvariantCulture)" y="@soyle.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)" width="@soyle.Bredde.ToString(System.Globalization.CultureInfo.InvariantCulture)" height="@soyle.Hoyde.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="rapport-histogram-soyle">
                            <title>@($"{soyle.Etikett}{enhet}: {soyle.Antall} deltaker(e)")</title>
                        </rect>
                        @if (soyle.Antall > 0)
                        {
                            @Html.Raw($"<text x=\"{(soyle.X + soyle.Bredde / 2).ToString(System.Globalization.CultureInfo.InvariantCulture)}\" y=\"{(soyle.Y - 4).ToString(System.Globalization.CultureInfo.InvariantCulture)}\" class=\"rapport-histogram-antall\" text-anchor=\"middle\">{soyle.Antall}</text>")
                        }
                        @Html.Raw($"<text x=\"{(soyle.X + soyle.Bredde / 2).ToString(System.Globalization.CultureInfo.InvariantCulture)}\" y=\"208\" class=\"rapport-histogram-etikett\" text-anchor=\"middle\">{soyle.Etikett}{enhet}</text>")
                    }
                    @foreach (var grense in Model.Grenselinjer)
                    {
                        <line x1="@grense.X.ToString(System.Globalization.CultureInfo.InvariantCulture)" y1="@grense.Y1.ToString(System.Globalization.CultureInfo.InvariantCulture)" x2="@grense.X.ToString(System.Globalization.CultureInfo.InvariantCulture)" y2="@grense.Y2.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="rapport-histogram-grenselinje">
                            <title>@($"{grense.Navn}: {grense.Verdi}{enhet}")</title>
                        </line>
                        @Html.Raw($"<text x=\"{grense.X.ToString(System.Globalization.CultureInfo.InvariantCulture)}\" y=\"14\" class=\"rapport-histogram-grenseetikett\" text-anchor=\"middle\">{grense.Navn}</text>")
                    }
                </svg>
            }

            @if (d.IndikatorFordeling.Any())
            {
                <h2>Fordeling</h2>
                <table border="1" cellpadding="6" cellspacing="0">
                    <thead>
                        <tr><th>Indikator</th><th>Verdi</th><th>Antall</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var indikator in d.IndikatorFordeling)
                    {
                        <tr>
                            <td>@indikator.IndikatorNavn</td>
                            <td>@indikator.Verdi</td>
                            <td>@indikator.Antall</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }

            <p><button type="button" class="btn btn-outline btn-sm" onclick="window.print()">Skriv ut</button></p>
        }
    }
}
else
{
    <h1>Aggregert rapport — @Model.GruppeNavn</h1>
    <p><a href="/Behandlerportal/Grupper/Rediger/@Model.Id">Tilbake til gruppen</a></p>

    <p>
        <a href="/Behandlerportal/Grupper/Aggregert/@Model.Id?provedata=true"><strong>@(Model.Provedata ? "▸" : "")</strong> Prøvedata</a>
        &nbsp;|&nbsp;
        <a href="/Behandlerportal/Grupper/Aggregert/@Model.Id?provedata=false"><strong>@(!Model.Provedata ? "▸" : "")</strong> Ekte pasienter</a>
    </p>

    @if (!Model.Provedata)
    {
        <form method="get">
            <input type="hidden" name="provedata" value="false" />
            <label>Fra <input type="date" name="fra" value="@Model.Fra.ToString("yyyy-MM-dd")" /></label>
            <label>Til <input type="date" name="til" value="@Model.Til.ToString("yyyy-MM-dd")" /></label>
            <button type="submit">Oppdater</button>
        </form>
    }

    @if (Model.Feilmelding is not null)
    {
        <p style="color: darkred;">@Model.Feilmelding</p>
    }
    else if (!Model.Rader.Any())
    {
        <p><em>Ingen fullførte besvarelser å aggregere ennå@(Model.Provedata ? " (prøvedata)" : " i den valgte perioden").</em></p>
    }
    else
    {
        @foreach (var rad in Model.Rader)
        {
            <div style="border: 1px solid #ccc; padding: 1rem; margin-bottom: 1rem;">
                <h2>@rad.TestNavn</h2>
                <p>Antall fullførte besvarelser: <strong>@rad.AntallFullfort</strong></p>
                @if (rad.AntallFullfort > 0)
                {
                    var radEnhet = rad.VisSomProsent ? "%" : $" / {rad.SkalaMaks}";
                    <p>
                        Gjennomsnitt: <strong>@(rad.Gjennomsnitt?.ToString("0.0"))@radEnhet</strong>
                        — Median: <strong>@(rad.Median?.ToString("0.0"))@radEnhet</strong>
                    </p>
                    @if (rad.IndikatorFordeling.Any())
                    {
                        <table border="1" cellpadding="6" cellspacing="0">
                            <thead>
                                <tr><th>Indikator</th><th>Verdi</th><th>Antall</th></tr>
                            </thead>
                            <tbody>
                            @foreach (var indikator in rad.IndikatorFordeling)
                            {
                                <tr>
                                    <td>@indikator.IndikatorNavn</td>
                                    <td>@indikator.Verdi</td>
                                    <td>@indikator.Antall</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                }
            </div>
        }
    }
}
