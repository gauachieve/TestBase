@page
@model TestBase.Web.Areas.Behandlerportal.Pages.Tildel.TesterModel
@{
    ViewData["Title"] = "Tildel tester";
}

<h1>Tildel tester — steg 2: velg tester</h1>

@if (Model.Feilmelding is not null)
{
    <p style="color: darkred;">@Model.Feilmelding</p>
}

@if (Model.Resultat is not null)
{
    <h2>Tildeling fullført</h2>
    @if (Model.Resultat.PerPasient.Any(r => r.Lenker.Any()))
    {
        <ul>
        @foreach (var rad in Model.Resultat.PerPasient.Where(r => r.Lenker.Any()))
        {
            <li>
                <strong>@(rad.Navn ?? "(ikke fullført)")</strong> —
                @if (rad.SendtSms) { <text>SMS sendt. </text> }
                @if (rad.SendtEpost) { <text>E-post sendt. </text> }
                @if (!rad.SendtSms && !rad.SendtEpost) { <text>Ingen varsel sendt (mangler kontaktinfo).</text> }
                <ul>
                @foreach (var lenke in rad.Lenker)
                {
                    <li>@lenke.TestNavn: <a href="@lenke.Lenke">@lenke.Lenke</a></li>
                }
                </ul>
            </li>
        }
        </ul>
    }
    @if (Model.Resultat.BehandlerOppgaver is { Count: > 0 })
    {
        <h2>Tester du skal fylle ut selv</h2>
        <p><em>Disse testene sendes ALDRI til pasienten — de fylles ut av deg, som en oppgave, og vises også på Min side.</em></p>
        <ul>
        @foreach (var oppgave in Model.Resultat.BehandlerOppgaver)
        {
            <li>@oppgave.TestNavn for <strong>@(oppgave.PasientNavn ?? "(ikke fullført)")</strong>: <a href="/Behandlerportal/Pasienter/FyllForPasient/@oppgave.TildelingId">Fyll ut nå</a></li>
        }
        </ul>
    }
    <p><a href="/Behandlerportal/Tildel/Pasienter">Tildel flere tester</a></p>
}
else if (Model.PlanlagtOpprettet)
{
    <h2>Utsending planlagt</h2>
    <p>Sendes @Model.PlanlagtTidspunktVisning?.ToString("g").</p>
    <p><a href="/Behandlerportal/Tildel/Pasienter">Tildel flere tester</a></p>
}
else if (Model.ValgtePasienter.Any())
{
    <p>Tildeler til: <strong>@string.Join(", ", Model.ValgtePasienter.Select(p => p.Pasient.Navn ?? "(ikke fullført)"))</strong></p>

    <p class="tildel-test-forklaring">
        <span><partial name="_Ikon" model="@("pluss")" /> Pasienten kan belastes for denne testen</span>
        <span><partial name="_Ikon" model="@("dollar")" /> Koster praksisen noe per gjennomføring</span>
        <span><partial name="_Ikon" model="@("klinikk")" /> <span class="tildel-test-klinikerutfylt">Fylles ut av deg (behandler), ikke pasienten</span></span>
    </p>

    <form method="post" asp-page-handler="Send" id="tildelForm"
          data-dekket-av-abonnement="@Model.Prisingskontekst.DekketAvAbonnement.ToString().ToLowerInvariant()"
          data-sms-gebyr-kr="@Model.Prisingskontekst.SmsGebyrKr.ToString(System.Globalization.CultureInfo.InvariantCulture)"
          data-antall-pasienter="@Model.ValgtePasienter.Count"
          data-disable-on-submit="Sender …">
        <input type="hidden" asp-for="PasientIderCsv" />

        <div>
            <label for="tildelTestSok">Søk i tester</label><br />
            <input type="search" id="tildelTestSok" data-tredfilter="#tildelKategoriTre" placeholder="Søk i testnavn …" />
        </div>

        <div class="tildel-med-info">
        <div class="tildel-kategori-tre" id="tildelKategoriTre">
        @foreach (var kategori in Model.KategoriTre)
        {
            <details open>
                <summary>@kategori.Kategori.Navn</summary>
                @if (!kategori.Tester.Any())
                {
                    <p><em>Ingen tester i denne kategorien ennå.</em></p>
                }
                else
                {
                    <ul>
                    @foreach (var test in kategori.Tester)
                    {
                        var visningsnavn = test.Navn + (string.IsNullOrEmpty(test.OversettelseNotat) ? "" : $" ({test.OversettelseNotat})");
                        <li data-sok="@visningsnavn.ToLowerInvariant()">
                            <label class="@(test.FyllesUtAvBehandler ? "tildel-test-klinikerutfylt" : "")">
                                <input type="checkbox" name="TestIder" value="@test.Id" class="tildel-test-checkbox" data-test-id="@test.Id"
                                       data-test-navn="@visningsnavn"
                                       data-beskrivelse="@test.Beskrivelse"
                                       data-rapport-introduksjon="@test.RapportIntroduksjon"
                                       data-estimert-min="@Model.EstimertMinutterPerTestId.GetValueOrDefault(test.Id)"
                                       data-minste-pris="@test.MinstePrisKr.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       data-storste-pris="@test.StorstePrisKr.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       data-typisk-honorar="@test.TypiskBehandlerHonorarKr.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       data-partner-andel="@Model.Prisingskontekst.EffektivPartnerAndelPerTestId.GetValueOrDefault(test.Id).ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                @test.Navn
                                @if (!string.IsNullOrEmpty(test.OversettelseNotat))
                                {
                                    <em>(@test.OversettelseNotat)</em>
                                }
                            </label>
                            @if (test.StorstePrisKr > 0)
                            {
                                <span class="tildel-ikon" title="Pasienten kan belastes for denne testen"><partial name="_Ikon" model="@("pluss")" /></span>
                            }
                            @if (test.HarKostnadPerGjennomforing)
                            {
                                <span class="tildel-ikon" title="Koster praksisen noe per gjennomføring"><partial name="_Ikon" model="@("dollar")" /></span>
                            }
                            @if (test.FyllesUtAvBehandler)
                            {
                                <span class="tildel-ikon" title="Fylles ut av deg (behandler), ikke pasienten"><partial name="_Ikon" model="@("klinikk")" /></span>
                            }
                        </li>
                    }
                    </ul>
                }
            </details>
        }
        </div>
        <aside class="test-infoboks skjult"></aside>
        </div>

        <button type="button" id="apneOppsummering" class="btn btn-accent">Gå til oppsummering</button>

        @{
            var prisedeTester = Model.KategoriTre.SelectMany(k => k.Tester).Where(t => t.StorstePrisKr > 0)
                .GroupBy(t => t.Id).Select(g => g.First()).ToList();
        }
        <dialog id="honorarDialog">
            <h2>Sett honorar</h2>
            <p>Angi ditt honorar for de prisede testene du har valgt. Stå tomt for å bruke ditt vanlige honorar.</p>
            <div id="honorarInnhold">
            @foreach (var test in prisedeTester)
            {
                <div class="tildel-honorar-rad" data-honorar-test-id="@test.Id" hidden>
                    <label>
                        @test.Navn — ditt honorar (NOK, maks @test.StorstePrisKr.ToString("0.00")):<br />
                        <input type="number" step="0.01" min="0" max="@test.StorstePrisKr.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="tall-input tildel-honorar-input"
                               id="honorar-@test.Id" data-test-id="@test.Id"
                               name="HonorarKr[@test.Id]" value="@Model.SistBrukteHonorarPerTestId.GetValueOrDefault(test.Id).ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                    </label>
                </div>
            }
            </div>
            <button type="button" id="honorarAvbryt" class="btn btn-muted">Tilbake</button>
            <button type="button" id="honorarNeste" class="btn btn-accent">Neste</button>
        </dialog>

        <partial name="_PlanleggingDialog" />

        <dialog id="oppsummeringDialog">
            <h2>Bekreft utsending</h2>

            <fieldset>
                <legend>Varslingsmetode for denne utsendingen</legend>
                <label><input type="radio" name="Varslingsmetode" value="Sms" class="tildel-varslingsmetode" /> SMS@(Model.Prisingskontekst.SmsGebyrKr > 0 ? $" (+{Model.Prisingskontekst.SmsGebyrKr.ToString("0.00")} NOK gebyr)" : "")</label>
                <label><input type="radio" name="Varslingsmetode" value="Epost" class="tildel-varslingsmetode" /> E-post</label>
                <label><input type="radio" name="Varslingsmetode" value="Begge" class="tildel-varslingsmetode" checked /> Begge@(Model.Prisingskontekst.SmsGebyrKr > 0 ? $" (+{Model.Prisingskontekst.SmsGebyrKr.ToString("0.00")} NOK SMS-gebyr)" : "")</label>
            </fieldset>
            @if (Model.Prisingskontekst.SmsGebyrKr > 0)
            {
                <p><em>Totalprisen under oppdateres automatisk når du bytter varslingsmetode — SMS legger til et eget gebyr, E-post gjør ikke det.</em></p>
            }

            <p>Du sender følgende tester:</p>
            <ul id="oppsummeringTester"></ul>
            <p id="oppsummeringTotal" style="font-weight: bold;"></p>
            <p id="oppsummeringPlanlegging" style="font-weight: bold;"></p>

            <p>til følgende pasienter:</p>
            <ul>
            @foreach (var p in Model.ValgtePasienter)
            {
                <li>@(p.Pasient.Navn ?? "(ikke fullført)")</li>
            }
            </ul>
            <button type="button" id="lukkOppsummering" class="btn btn-muted">Avbryt</button>
            <button type="submit" asp-page-handler="Send" class="btn btn-accent" id="sendNaaKnapp">Bekreft og send</button>
            <button type="submit" asp-page-handler="Planlegg" class="btn btn-accent" id="sendPlanlagtKnapp" hidden>Bekreft og planlegg</button>
        </dialog>
    </form>

    <script src="~/js/tildel.js" asp-append-version="true"></script>
    <script src="~/js/testinfo.js" asp-append-version="true"></script>
    <script src="~/js/testtre-filter.js" asp-append-version="true"></script>
}
else
{
    <p>Ingen gyldige pasienter valgt. <a href="/Behandlerportal/Tildel/Pasienter">Gå tilbake til steg 1</a>.</p>
}

<p><a href="/Behandlerportal/Pasienter">Tilbake til pasienter</a></p>
