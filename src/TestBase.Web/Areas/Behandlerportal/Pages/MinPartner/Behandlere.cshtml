@page
@model TestBase.Web.Areas.Behandlerportal.Pages.MinPartner.BehandlereModel
@{
    ViewData["Title"] = "Min klinikk";
}

<partial name="_MinKlinikkNav" model="new TestBase.Web.Areas.Behandlerportal.Pages.MinPartner.MinKlinikkNavModel(Model.ErPartnerAdministrator, Model.AntallTilgjengeligeTester)" />

@if (Model.Feilmelding is not null)
{
    <p style="color: darkred;">@Model.Feilmelding</p>
}

@if (Model.MinPartner is not null)
{
    <ul>
        <li><strong>Navn:</strong> @Model.MinPartner.Navn</li>
        <li><strong>Kontaktperson:</strong> @(Model.MinPartner.KontaktpersonNavn ?? "-")</li>
        <li><strong>Kontakt e-post:</strong> @(Model.MinPartner.KontaktEpost ?? "-")</li>
        <li><strong>Kontakt mobil:</strong> @(Model.MinPartner.KontaktMobilNr ?? "-")</li>
        <li><strong>Abonnement:</strong> @(Model.MinPartner.HarAktivtAbonnement ? "Aktivt" : "Ingen")</li>
    </ul>
}

@if (Model.ErPartnerAdministrator)
{
    <p><a class="btn btn-outline" href="/Behandlerportal/MinPartner/Rediger">Editer felter</a></p>
}
