@page
@model TestBase.Web.Areas.Behandlerportal.Pages.MinPartner.PrisingModel
@using TestBase.Shared.Domain.Tester
@{
    ViewData["Title"] = "Min partner — prising";
}

<h1>Min partners andel per test</h1>
<p>Andelen klemmes alltid opp til minst det Superadmin har satt som gulv for testen.</p>

@if (Model.Feilmelding is not null)
{
    <p style="color: darkred;">@Model.Feilmelding</p>
}
@if (Model.Melding is not null)
{
    <p style="color: darkgreen;">@Model.Melding</p>
}

@if (Model.VentendeForesporsler.Any())
{
    <h2>Ventende forespørsler</h2>
    <p>Sendt til administrator for godkjenning — trer i kraft når godkjent.</p>
    <ul>
    @foreach (var f in Model.VentendeForesporsler)
    {
        <li>
            @(f.Handling == TestTilgangHandling.LeggTil ? "Legge til" : "Fjerne") @Model.TestNavnById.GetValueOrDefault(f.TestId, "(ukjent test)")
            — sendt @f.ForespurtUtc.ToString("g")
        </li>
    }
    </ul>
}

<form method="post" class="skjema-bred">
    <table border="1" cellpadding="6" cellspacing="0">
        <thead>
            <tr>
                <th>Test</th>
                <th>Vår andel (NOK)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var rad in Model.Tester)
        {
            <tr>
                <td>@rad.Test.Navn</td>
                <td><input type="number" step="0.01" min="@rad.Test.MinstePartnerAndelKr.ToString(System.Globalization.CultureInfo.InvariantCulture)" name="AndelKr[@rad.Test.Id]" value="@rad.EffektivAndelKr.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="tall-input" /></td>
                <td>
                    <form method="post" asp-page-handler="ForesporTilgang" style="display:inline;" data-disable-on-submit="Sender …">
                        <input type="hidden" name="testId" value="@rad.Test.Id" />
                        <input type="hidden" name="handling" value="@nameof(TestTilgangHandling.Fjern)" />
                        <button type="submit" class="btn-icon">Be om fjerning</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <p><button type="submit" class="btn-accent" data-disable-on-submit="Lagrer …">Lagre alle endringer</button></p>
</form>

<h2>Alle tester</h2>
<details>
    <summary>Vis alle tester (be om tilgang til flere)</summary>
    @if (!Model.TesterUtenTilgang.Any())
    {
        <p>Partneren har allerede tilgang til alle aktive tester.</p>
    }
    else
    {
        <table border="1" cellpadding="6" cellspacing="0">
            <thead>
                <tr>
                    <th>Test</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var test in Model.TesterUtenTilgang)
            {
                <tr>
                    <td>@test.Navn</td>
                    <td>
                        <form method="post" asp-page-handler="ForesporTilgang" style="display:inline;" data-disable-on-submit="Sender …">
                            <input type="hidden" name="testId" value="@test.Id" />
                            <input type="hidden" name="handling" value="@nameof(TestTilgangHandling.LeggTil)" />
                            <button type="submit" class="btn-accent">Be om tilgang</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</details>
