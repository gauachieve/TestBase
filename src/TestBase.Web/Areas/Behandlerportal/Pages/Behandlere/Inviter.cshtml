@page
@model TestBase.Web.Areas.Behandlerportal.Pages.Behandlere.InviterModel
@{
    ViewData["Title"] = "Inviter kollega";
}

<h1>Inviter en kollega som behandler</h1>

@if (Model.Sendt)
{
    <p>Invitasjon sendt (SMS er fortsatt mock; e-post sendes reelt der Azure Communication Services
    er satt opp, ellers mock). Del uansett denne lenken med kollegaen for at de skal kunne
    fullføre registreringen:</p>
    <p><a href="@Model.Lenke">@Model.Lenke</a></p>
    <p><a href="/Behandlerportal/Behandlere/Inviter">Inviter en til</a></p>
}
else
{
    @if (Model.Feilmelding is not null)
    {
        <p style="color: darkred;">@Model.Feilmelding</p>
    }

    <form method="post">
        <div><label>Mobilnummer</label><br /><input asp-for="MobilNr" /></div>
        <div><label>eller e-post</label><br /><input asp-for="Epost" /></div>
        <button type="submit">Send invitasjon</button>
    </form>
}
