@page
@model TestBase.Web.Areas.Behandlerportal.Pages.Hjemmeoppgaver.IndexModel
@{
    ViewData["Title"] = "Hjemmeoppgaver";
}

<h1>Hjemmeoppgaver</h1>

@if (Model.Melding is not null)
{
    <p class="rapport-status-melding">@Model.Melding</p>
}

<div data-fane-beholder>
    <div role="tablist" style="margin-bottom: 1rem;">
        <button type="button" data-fane="personlig" class="fane-knapp">Personlig (@Model.Personlige.Count)</button>
        <button type="button" data-fane="delt" class="fane-knapp">Delt (@Model.DeltMedAlle.Count)</button>
        @if (Model.HarPartner)
        {
            <button type="button" data-fane="partner" class="fane-knapp">Partner (@Model.DeltMedPartner.Count)</button>
        }
        <button type="button" data-fane="opprett" class="fane-knapp">+ Opprett</button>
    </div>
    <div>
        <label>Søk</label><br />
        <input type="search" data-fane-sok placeholder="Søk i hjemmeoppgaver …" />
    </div>

    <table border="1" cellpadding="6" cellspacing="0">
        <thead>
            <tr>
                <th>Navn</th>
                <th>Opprettet</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var test in Model.Personlige)
        {
            var erEgen = test.OpprettetAvBehandlerId == Model.EgenBehandlerId;
            <tr data-fane-rad="personlig" data-sok="@test.Navn.ToLowerInvariant()">
                <td>@test.Navn @(erEgen ? "" : "(likt — referanse)")</td>
                <td>@test.OpprettetUtc.ToString("g")</td>
                <td>
                    @if (erEgen)
                    {
                        <a class="btn-icon" href="/Behandlerportal/Hjemmeoppgaver/Rediger/@test.Id" title="Rediger" aria-label="Rediger"><partial name="_Ikon" model="@("rediger")" /></a>

                        <form method="post" asp-page-handler="DelMedAlle" style="display:inline;">
                            <input type="hidden" name="testId" value="@test.Id" />
                            <input type="hidden" name="verdi" value="@((!test.ErDeltMedAlle).ToString())" />
                            <button type="submit" class="btn-icon @(test.ErDeltMedAlle ? "btn-icon--aktiv" : "")" title="@(test.ErDeltMedAlle ? "Avslutt deling (alle)" : "Del med alle")" aria-label="@(test.ErDeltMedAlle ? "Avslutt deling (alle)" : "Del med alle")"><partial name="_Ikon" model="@("del")" /></button>
                        </form>

                        @if (Model.HarPartner)
                        {
                            <form method="post" asp-page-handler="DelMedPartner" style="display:inline;">
                                <input type="hidden" name="testId" value="@test.Id" />
                                <input type="hidden" name="verdi" value="@((!test.ErDeltMedPartner).ToString())" />
                                <button type="submit" class="btn-icon btn-icon--partner @(test.ErDeltMedPartner ? "btn-icon--aktiv" : "")" title="@(test.ErDeltMedPartner ? "Avslutt deling (partner)" : "Del med partner")" aria-label="@(test.ErDeltMedPartner ? "Avslutt deling (partner)" : "Del med partner")"><partial name="_Ikon" model="@("behandlere")" /></button>
                            </form>
                        }

                        <form method="post" asp-page-handler="Slett" style="display:inline;" onsubmit="return confirm('Slette denne hjemmeoppgaven?');">
                            <input type="hidden" name="testId" value="@test.Id" />
                            <button type="submit" class="btn-icon btn-icon--slett" title="Slett" aria-label="Slett"><partial name="_Ikon" model="@("slett")" /></button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Kopier" style="display:inline;">
                            <input type="hidden" name="testId" value="@test.Id" />
                            <button type="submit" class="btn-icon" title="Rediger (lager kopi)" aria-label="Rediger (lager kopi)"><partial name="_Ikon" model="@("kopier")" /></button>
                        </form>
                        <form method="post" asp-page-handler="FjernLiking" style="display:inline;">
                            <input type="hidden" name="testId" value="@test.Id" />
                            <button type="submit" class="btn-icon btn-icon--muted" title="Fjern fra personlig" aria-label="Fjern fra personlig"><partial name="_Ikon" model="@("tilbakekall")" /></button>
                        </form>
                    }
                </td>
            </tr>
        }
        @foreach (var test in Model.DeltMedAlle)
        {
            var erEgen = test.OpprettetAvBehandlerId == Model.EgenBehandlerId;
            var erLikt = Model.LikteTestIder.Contains(test.Id);
            <tr data-fane-rad="delt" data-sok="@test.Navn.ToLowerInvariant()">
                <td>@test.Navn @(erEgen ? "(din egen)" : "")</td>
                <td>@test.OpprettetUtc.ToString("g")</td>
                <td>
                    @if (erEgen)
                    {
                        <span class="btn-icon btn-icon--muted" title="Din egen — se i Personlig" aria-label="Din egen"><partial name="_Ikon" model="@("hjemmeoppgave")" /></span>
                    }
                    else if (erLikt)
                    {
                        <span class="btn-icon btn-icon--aktiv" title="Likt — se i Personlig" aria-label="Likt"><partial name="_Ikon" model="@("lik")" /></span>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Lik" style="display:inline;">
                            <input type="hidden" name="testId" value="@test.Id" />
                            <button type="submit" class="btn-icon" title="Lik" aria-label="Lik"><partial name="_Ikon" model="@("lik")" /></button>
                        </form>
                    }
                </td>
            </tr>
        }
        @foreach (var test in Model.DeltMedPartner)
        {
            var erEgen = test.OpprettetAvBehandlerId == Model.EgenBehandlerId;
            var erLikt = Model.LikteTestIder.Contains(test.Id);
            <tr data-fane-rad="partner" data-sok="@test.Navn.ToLowerInvariant()">
                <td>@test.Navn @(erEgen ? "(din egen)" : "")</td>
                <td>@test.OpprettetUtc.ToString("g")</td>
                <td>
                    @if (erEgen)
                    {
                        <span class="btn-icon btn-icon--muted" title="Din egen — se i Personlig" aria-label="Din egen"><partial name="_Ikon" model="@("hjemmeoppgave")" /></span>
                    }
                    else if (erLikt)
                    {
                        <span class="btn-icon btn-icon--aktiv" title="Likt — se i Personlig" aria-label="Likt"><partial name="_Ikon" model="@("lik")" /></span>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Lik" style="display:inline;">
                            <input type="hidden" name="testId" value="@test.Id" />
                            <button type="submit" class="btn-icon" title="Lik" aria-label="Lik"><partial name="_Ikon" model="@("lik")" /></button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>

    <div data-fane-rad="personlig" data-sok="" hidden style="margin-top: 1rem;">
    @if (!Model.Personlige.Any())
    {
        <p><em>Du har ikke laget eller likt noen hjemmeoppgaver ennå.</em></p>
    }
    </div>
    <div data-fane-rad="delt" data-sok="" hidden style="margin-top: 1rem;">
    @if (!Model.DeltMedAlle.Any())
    {
        <p><em>Ingen andre behandlere har delt en hjemmeoppgave med alle ennå.</em></p>
    }
    </div>
    @if (Model.HarPartner)
    {
        <div data-fane-rad="partner" data-sok="" hidden style="margin-top: 1rem;">
        @if (!Model.DeltMedPartner.Any())
        {
            <p><em>Ingen kolleger i din partner har delt en hjemmeoppgave ennå.</em></p>
        }
        </div>
    }

    <div data-fane-rad="opprett" hidden style="margin-top: 1rem;">
        <p><a href="/Behandlerportal/Hjemmeoppgaver/Rediger" class="btn-accent">+ Ny hjemmeoppgave</a></p>
    </div>
</div>

<script src="~/js/faner.js" asp-append-version="true"></script>
