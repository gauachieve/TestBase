@page
@model TestBase.Web.Areas.Behandlerportal.Pages.Pasienter.IndexModel
@using TestBase.Shared.Domain.Pasienter
@{
    ViewData["Title"] = "Pasienter";
}

<h1>Mine pasienter</h1>
<p>
    <a href="/Behandlerportal/Pasienter/Ny">+ Legg til pasient</a> |
    <a href="/Behandlerportal/Pasienter/Gruppeimport">Gruppeimport</a>
</p>

<div>
    <label for="pasientSok">Søk</label><br />
    <input type="search" id="pasientSok" data-tabellfilter="#pasientTabell"
           placeholder="Søk i navn, gruppe, mobil, e-post, personnummer, status …" />
</div>

<table id="pasientTabell" border="1" cellpadding="6" cellspacing="0">
    <thead>
        <tr>
            <th>Navn</th>
            <th>Gruppe</th>
            <th>Mobil</th>
            <th>E-post</th>
            <th>Personnummer</th>
            <th>Tildelt</th>
            <th>Besvart</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var rad in Model.Rader)
    {
        var p = rad.Pasient;
        var sok = $"{p.Navn} {p.Gruppenavn} {p.MobilNr} {p.Email} {p.Personnummer} {p.Status}".ToLowerInvariant();
        <tr data-sok="@sok">
            <td><a href="/Behandlerportal/Pasienter/Detaljer/@p.Id">@(p.Navn ?? "(ikke fullført)")</a></td>
            <td>@(p.Gruppenavn ?? "-")</td>
            <td>@p.MobilNr</td>
            <td>@p.Email</td>
            <td>@p.Personnummer</td>
            <td>@rad.Tildelt</td>
            <td>@rad.Besvart</td>
            <td>@p.Status</td>
            <td>
                <a class="btn-icon" href="/Behandlerportal/Pasienter/Rediger/@p.Id" title="Rediger" aria-label="Rediger">
                    <partial name="_Ikon" model="@("rediger")" />
                </a>
                <form method="post" asp-page-handler="Arkiver" style="display:inline;">
                    <input type="hidden" name="id" value="@p.Id" />
                    <button type="submit" class="btn-icon" title="@(p.Status == PasientStatus.Arkivert ? "Gjenopprett" : "Arkiver")" aria-label="@(p.Status == PasientStatus.Arkivert ? "Gjenopprett" : "Arkiver")">
                        <partial name="_Ikon" model="@(p.Status == PasientStatus.Arkivert ? "gjenopprett" : "arkiver")" />
                    </button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<script src="~/js/tabellfilter.js"></script>
