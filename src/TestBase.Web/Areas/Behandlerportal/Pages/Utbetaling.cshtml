@page
@model TestBase.Web.Areas.Behandlerportal.Pages.UtbetalingModel
@{
    ViewData["Title"] = "Utbetaling";
    var manedNavn = System.Globalization.CultureInfo.GetCultureInfo("nb-NO").DateTimeFormat.GetMonthName(Model.ValgtManed);
}

<h1>Utbetaling</h1>

<div data-fane-beholder>
    <div class="fane-rad" role="tablist">
        <button type="button" class="fane-knapp" data-fane="tilkobling">Tilkobling</button>
        <button type="button" class="fane-knapp" data-fane="honorarutskrift">Honorarutskrift</button>
        <button type="button" class="fane-knapp" data-fane="oppsett">Oppsett</button>
    </div>

    <div data-fane-rad="tilkobling" hidden>
        <p>Koble til en bankkonto for å motta honorar automatisk, én gang i måneden. Selve bankkontoen
           samles inn og oppbevares av Stripe — ikke av oss.</p>

        @if (Model.Feilmelding is not null)
        {
            <p class="feilmelding">@Model.Feilmelding</p>
        }

        @if (Model.Konto is null)
        {
            <form method="post" asp-page-handler="StartOnboarding">
                <button type="submit" class="btn btn-accent" data-disable-on-submit="Starter …">Koble til utbetalingskonto</button>
            </form>
        }
        else if (Model.Konto.Status == TestBase.Shared.Domain.Utbetaling.StripeConnectStatus.OnboardingFullfort)
        {
            <p><strong>✓ Tilkoblet.</strong> Honorar betales ut automatisk hver måned til kontoen du har registrert hos Stripe.</p>
        }
        else
        {
            <p><strong>Tilkobling startet, men ikke fullført ennå.</strong> Fullfør registreringen hos Stripe for å kunne motta utbetaling.</p>
            <form method="post" asp-page-handler="StartOnboarding">
                <button type="submit" class="btn btn-accent" data-disable-on-submit="Starter …">Fortsett registrering hos Stripe</button>
            </form>
        }
    </div>

    <div data-fane-rad="honorarutskrift" hidden>
        <form method="get" action="?#honorarutskrift" class="rapport-periodevelger">
            <div>
                <label for="aar">År</label>
                <select id="aar" name="Aar">
                    @for (var aar = DateTimeOffset.UtcNow.Year; aar >= DateTimeOffset.UtcNow.Year - 3; aar--)
                    {
                        <option value="@aar" selected="@(aar == Model.ValgtAar)">@aar</option>
                    }
                </select>
            </div>
            <div>
                <label for="maaned">Måned</label>
                <select id="maaned" name="Maaned">
                    @for (var m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == Model.ValgtManed)">@System.Globalization.CultureInfo.GetCultureInfo("nb-NO").DateTimeFormat.GetMonthName(m)</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-accent">Vis</button>
        </form>

        <div class="rapport-ark">
            <div class="rapport-hjornedekor"></div>
            <div class="rapport-tittelblokk">
                <span class="rapport-tittel-stor">Honorarutskrift</span>
                <span class="rapport-tittel-liten">@manedNavn @Model.ValgtAar</span>
            </div>
            <div class="rapport-metarad">
                <span>Behandler: <strong>@(Model.Oppsett.Visningsnavn ?? Model.Oppsett.Email)</strong></span>
                <span>Generert: <strong>@DateTimeOffset.UtcNow.ToString("dd.MM.yyyy")</strong></span>
            </div>

            <p class="rapport-introduksjon">
                <strong>Dette er ditt eget inntektsbilag,</strong> ikke bare en oversikt — honoraret under
                er salgsinntekt for helsetjeneste, unntatt mva, bokført mot kontoen du selv har satt opp
                under "Oppsett" (standard 3100). Ingen pasientnavn — "Ref." er tildelings-IDen.
            </p>

            @if (!Model.Rapport.Rader.Any())
            {
                <p><em>Ingen betalte tester i denne perioden.</em></p>
            }
            else
            {
                <div class="rapport-seksjon">
                    <span class="rapport-seksjon-tittel">Fullførte og betalte tester</span>
                    <div class="rapport-tabellramme">
                        <table class="rapport-svartabell">
                            <thead><tr><th>Dato</th><th>Ref.</th><th>Test</th><th class="tall">Honorar</th></tr></thead>
                            <tbody>
                            @foreach (var rad in Model.Rapport.Rader)
                            {
                                <tr>
                                    <td>@rad.Dato.ToString("dd.MM.yyyy")</td>
                                    <td class="ref">T-@rad.TestTildelingId</td>
                                    <td>@rad.TestNavn</td>
                                    <td class="tall">@rad.HonorarKr.ToString("N2") kr</td>
                                </tr>
                            }
                            <tr class="sum"><td colspan="3">Totalt honorar for perioden</td><td class="tall">@Model.Rapport.SumHonorar.ToString("N2") kr</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="rapport-seksjon">
                    <span class="rapport-seksjon-tittel">Bokføringsforslag (din egen kontoplan)</span>
                    <div class="rapport-tabellramme">
                        <table class="rapport-svartabell">
                            <thead><tr><th>Beskrivelse</th><th>Debet</th><th>Kredit</th><th class="tall">Beløp</th></tr></thead>
                            <tbody>
                                <tr>
                                    <td>@(Model.Oppsett.HonorarinntektEtikett ?? TestBase.Shared.Domain.Tester.OkonomiOppsettStandard.BehandlerHonorarinntektEtikett)</td>
                                    <td>1920 Bank</td>
                                    <td>@(Model.Oppsett.HonorarinntektKonto ?? TestBase.Shared.Domain.Tester.OkonomiOppsettStandard.BehandlerHonorarinntektKonto) Salgsinntekt tjenester</td>
                                    <td class="tall">@Model.Rapport.SumHonorar.ToString("N2") kr</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <p class="rapport-felt-hjelp" style="margin-top: 1.5rem;">Utbetales av GGPsykolog AS iht. avtalt honorarsats per test.</p>
        </div>
    </div>

    <div data-fane-rad="oppsett" hidden>
        @if (Model.OppsettLagret)
        {
            <p style="color: var(--success-dark);">✓ Oppsett lagret.</p>
        }
        <form method="post" asp-page-handler="LagreOppsett">
            <div class="rapport-seksjon">
                <span class="rapport-seksjon-tittel">Dine opplysninger</span>
                <div class="rapport-felt-gruppe">
                    <div class="rapport-felt">
                        <label for="hprnr">HPR-nummer (eget)</label>
                        <input type="text" id="hprnr" name="hprNr" value="@Model.Oppsett.HprNr" />
                    </div>
                    <div class="rapport-felt">
                        <label for="kontonr">Mottakskonto (bankkontonummer — informasjon, selve utbetalingen går via Stripe Connect under "Tilkobling")</label>
                        <input type="text" id="kontonr" name="kontonummer" value="@Model.Oppsett.Kontonummer" />
                    </div>
                </div>
            </div>

            <div class="rapport-seksjon">
                <span class="rapport-seksjon-tittel">Kontoplan</span>
                <div class="rapport-kontoplan-header"><span>Etikett</span><span>Konto</span><span>Type</span></div>
                <div class="rapport-kontoplan-rad">
                    <input type="text" name="honorarinntektEtikett" value="@(Model.Oppsett.HonorarinntektEtikett ?? TestBase.Shared.Domain.Tester.OkonomiOppsettStandard.BehandlerHonorarinntektEtikett)" />
                    <input type="text" name="honorarinntektKonto" value="@(Model.Oppsett.HonorarinntektKonto ?? TestBase.Shared.Domain.Tester.OkonomiOppsettStandard.BehandlerHonorarinntektKonto)" />
                    <span class="rapport-kontoplan-type rapport-kontoplan-type--inntekt">Inntekt</span>
                </div>
            </div>

            <button type="submit" class="btn btn-accent">Lagre oppsett</button>
        </form>
    </div>
</div>

<script src="~/js/faner.js" asp-append-version="true"></script>
