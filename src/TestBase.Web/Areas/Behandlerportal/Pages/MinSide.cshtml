@page
@model TestBase.Web.Areas.Behandlerportal.Pages.MinSideModel
@{
    ViewData["Title"] = "Min side";
}

<h1>Min side @(Model.AntallOppgaver > 0 ? $"({Model.AntallOppgaver})" : "")</h1>

<p><a href="/Behandlerportal/Innstillinger">Innstillinger</a></p>

@if (Model.UtlopteHprFrister.Any())
{
    <h2>HPR-godkjenning utløpt for kolleger (@Model.UtlopteHprFrister.Count)</h2>
    <table border="1" cellpadding="6" cellspacing="0">
        <thead>
            <tr>
                <th>Behandler</th>
                <th>HPR-nr</th>
                <th>E-post</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var b in Model.UtlopteHprFrister)
        {
            <tr>
                <td>@(b.Visningsnavn ?? "(ikke fullført)")</td>
                <td>@(b.HprNr ?? "-")</td>
                <td>@b.Email</td>
                <td>
                    <form method="post" asp-page-handler="GodkjennHpr" style="display:inline;">
                        <input type="hidden" name="id" value="@b.Id" />
                        <button type="submit" class="btn-icon" title="Godkjenn HPR" aria-label="Godkjenn HPR">
                            <partial name="_Ikon" model="@("godkjenn")" />
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<h2>Venter på godkjenning (@Model.VenterPaaGodkjenning.Count)</h2>
@if (!Model.VenterPaaGodkjenning.Any())
{
    <p>Ingen fullførte tester venter på godkjenning.</p>
}
else
{
    <table border="1" cellpadding="6" cellspacing="0">
        <thead>
            <tr>
                <th>Pasient</th>
                <th>Test</th>
                <th>Fullført</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var rad in Model.VenterPaaGodkjenning)
        {
            <tr>
                <td>@(rad.PasientNavn ?? "(ikke fullført registrering)")</td>
                <td>@rad.TestNavn</td>
                <td>@rad.Tildeling.FullfortUtc?.ToString("g")</td>
                <td><a href="/Behandlerportal/Pasienter/Rapport/@rad.Tildeling.Id">Se rapport og godkjenn</a></td>
            </tr>
        }
        </tbody>
    </table>
}

<h2>Meldinger (@Model.UlesteMeldinger.Count uleste)</h2>

@if (!Model.UlesteMeldinger.Any())
{
    <p>Ingen nye meldinger. Du får en melding her hver gang en pasient fullfører en test.</p>
}
else
{
    <ul>
    @foreach (var melding in Model.UlesteMeldinger)
    {
        <li>
            <strong>@(melding.PasientNavn ?? "(ikke fullført registrering)")</strong> fullførte <em>@melding.TestNavn</em>
            @(melding.Melding.OpprettetUtc.ToString("g")) —
            <a href="/Behandlerportal/Pasienter/Rapport/@melding.TestTildelingId">Se rapport</a>
        </li>
    }
    </ul>
}

<h2>Ikke besvart ennå (@Model.IkkeFullfort.Count)</h2>
@if (!Model.IkkeFullfort.Any())
{
    <p>Alle tildelte tester er besvart.</p>
}
else
{
    <table border="1" cellpadding="6" cellspacing="0">
        <thead>
            <tr>
                <th>Pasient</th>
                <th>Test</th>
                <th>Status</th>
                <th>Tildelt</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var rad in Model.IkkeFullfort)
        {
            <tr>
                <td>@(rad.PasientNavn ?? "(ikke fullført registrering)")</td>
                <td>@rad.TestNavn</td>
                <td>@rad.Tildeling.Status</td>
                <td>@rad.Tildeling.TildeltUtc.ToString("d")</td>
                <td><a href="/Behandlerportal/Pasienter/Detaljer/@rad.PasientId">Se pasient</a></td>
            </tr>
        }
        </tbody>
    </table>
}
