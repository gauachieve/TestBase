@page
@model TestBase.Web.Areas.Behandlerportal.Pages.Konto.LoggInnModel
@{
    ViewData["Title"] = "Logg inn som behandler";
}

<h1>Logg inn som behandler</h1>

@if (Model.Feilmelding is not null)
{
    <p style="color: darkred;">@Model.Feilmelding</p>
}

<form method="post">
    <div>
        <label><input asp-for="HuskMeg" type="checkbox" /> Husk meg</label>
    </div>
    <button type="submit">Logg inn med BankID</button>
</form>

<p>
    Behandlere logger alltid inn med BankID + SMS-kode (mock — ingen ekte BankID/SMS kontaktes i
    dev). Har du ikke fullført registreringen ennå, bruk invitasjonslenken du mottok.
</p>
