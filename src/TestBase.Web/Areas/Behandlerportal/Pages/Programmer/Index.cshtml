@page
@model TestBase.Web.Areas.Behandlerportal.Pages.Programmer.IndexModel
@{
    ViewData["Title"] = "Programmer";
}

<h1>Programmer</h1>

@if (Model.Melding is not null)
{
    <p class="rapport-status-melding">@Model.Melding</p>
}

<div data-fane-beholder data-flervalg-beholder>
    <div role="tablist" style="margin-bottom: 1rem;">
        <button type="button" data-fane="kjorende" class="fane-knapp">Kjørende (@Model.Kjorende.Count)</button>
        <button type="button" data-fane="personlig" class="fane-knapp">Personlig (@Model.Personlige.Count)</button>
        <button type="button" data-fane="delt" class="fane-knapp">Delt (@Model.DeltMedAlle.Count)</button>
        @if (Model.HarPartner)
        {
            <button type="button" data-fane="partner" class="fane-knapp">Partner (@Model.DeltMedPartner.Count)</button>
        }
        <button type="button" data-fane="opprett" class="fane-knapp">+ Opprett</button>
    </div>
    <div>
        <label>Søk</label><br />
        <input type="search" data-fane-sok placeholder="Søk …" />
    </div>

    <div data-flervalg-verktoylinje hidden style="margin-bottom: 0.75rem;">
        <strong><span data-flervalg-antall>0</span> valgt</strong>
        <button type="submit" form="programFlervalgSkjema" asp-page-handler="SlettValgte" class="btn btn-outline btn-sm">
            <partial name="_Ikon" model="@("slett")" /> Fjern valgte
        </button>
    </div>
    <form id="programFlervalgSkjema" method="post" onsubmit="return confirm('Fjerne (eller arkivere, hvis i bruk) de valgte programmene?');"></form>

    <table border="1" cellpadding="6" cellspacing="0">
        <thead>
            <tr><th><input type="checkbox" data-flervalg-alle aria-label="Velg alle" /></th><th>Program</th><th>Startet</th><th>Gjenstående drops</th><th>Deltakere</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var rad in Model.Kjorende)
        {
            var visningsnavn = rad.GruppeNavn is not null ? $"{rad.ProgramNavn} ({rad.GruppeNavn})" : $"{rad.ProgramNavn} — {rad.PasientNavn ?? "(ikke fullført)"}";
            <tr data-fane-rad="kjorende" data-sok="@visningsnavn.ToLowerInvariant()">
                <td></td>
                <td>@visningsnavn</td>
                <td>@rad.Startet.ToString("g")</td>
                <td>@rad.AntallGjenstaendeDrops</td>
                <td>@rad.AntallDeltakere</td>
                <td>
                    <form method="post" asp-page-handler="PauseKjorende" style="display:inline;">
                        @foreach (var id in rad.DeltakelseIder)
                        {
                            <input type="hidden" name="deltakelseIder" value="@id" />
                        }
                        <button type="submit" class="btn-icon" title="Pause" aria-label="Pause"><partial name="_Ikon" model="@("frys")" /></button>
                    </form>
                    <form method="post" asp-page-handler="FjernKjorende" style="display:inline;" onsubmit="return confirm('Fjerne alle fra programmet? Fremtidige drops kanselleres.');">
                        @foreach (var id in rad.DeltakelseIder)
                        {
                            <input type="hidden" name="deltakelseIder" value="@id" />
                        }
                        <button type="submit" class="btn-icon btn-icon--slett" title="Fjern" aria-label="Fjern"><partial name="_Ikon" model="@("slett")" /></button>
                    </form>
                </td>
            </tr>
        }
        @foreach (var program in Model.Personlige)
        {
            var erEgen = program.OpprettetAvBehandlerId == Model.EgenBehandlerId;
            <tr data-fane-rad="personlig" data-sok="@program.Navn.ToLowerInvariant()">
                <td>
                    @if (erEgen)
                    {
                        <input type="checkbox" name="programId" value="@program.Id" form="programFlervalgSkjema" data-flervalg-rad aria-label="Velg @program.Navn" />
                    }
                </td>
                <td colspan="3">@program.Navn @(erEgen ? "" : "(likt — referanse)")</td>
                <td>@program.OpprettetUtc.ToString("g")</td>
                <td>
                    @if (erEgen)
                    {
                        <a class="btn-icon" href="/Behandlerportal/Programmer/Rediger/@program.Id" title="Rediger" aria-label="Rediger"><partial name="_Ikon" model="@("rediger")" /></a>
                        <a class="btn-icon" href="/Behandlerportal/Programmer/Tildel/@program.Id" title="Tildel" aria-label="Tildel"><partial name="_Ikon" model="@("tildel")" /></a>
                        <form method="post" asp-page-handler="DelMedAlle" style="display:inline;">
                            <input type="hidden" name="programId" value="@program.Id" />
                            <input type="hidden" name="verdi" value="@((!program.ErDeltMedAlle).ToString())" />
                            <button type="submit" class="btn-icon @(program.ErDeltMedAlle ? "btn-icon--aktiv" : "")" title="@(program.ErDeltMedAlle ? "Avslutt deling (alle)" : "Del med alle")" aria-label="@(program.ErDeltMedAlle ? "Avslutt deling (alle)" : "Del med alle")"><partial name="_Ikon" model="@("del")" /></button>
                        </form>
                        @if (Model.HarPartner)
                        {
                            <form method="post" asp-page-handler="DelMedPartner" style="display:inline;">
                                <input type="hidden" name="programId" value="@program.Id" />
                                <input type="hidden" name="verdi" value="@((!program.ErDeltMedPartner).ToString())" />
                                <button type="submit" class="btn-icon btn-icon--partner @(program.ErDeltMedPartner ? "btn-icon--aktiv" : "")" title="@(program.ErDeltMedPartner ? "Avslutt deling (partner)" : "Del med partner")" aria-label="@(program.ErDeltMedPartner ? "Avslutt deling (partner)" : "Del med partner")"><partial name="_Ikon" model="@("behandlere")" /></button>
                            </form>
                        }
                        <form method="post" asp-page-handler="Slett" style="display:inline;" onsubmit="return confirm('Slette dette programmet?');">
                            <input type="hidden" name="programId" value="@program.Id" />
                            <button type="submit" class="btn-icon btn-icon--slett" title="Slett" aria-label="Slett"><partial name="_Ikon" model="@("slett")" /></button>
                        </form>
                    }
                    else
                    {
                        <a class="btn-icon" href="/Behandlerportal/Programmer/Tildel/@program.Id" title="Tildel" aria-label="Tildel"><partial name="_Ikon" model="@("tildel")" /></a>
                        <form method="post" asp-page-handler="Kopier" style="display:inline;">
                            <input type="hidden" name="programId" value="@program.Id" />
                            <button type="submit" class="btn-icon" title="Rediger (lager kopi)" aria-label="Rediger (lager kopi)"><partial name="_Ikon" model="@("kopier")" /></button>
                        </form>
                        <form method="post" asp-page-handler="FjernLiking" style="display:inline;">
                            <input type="hidden" name="programId" value="@program.Id" />
                            <button type="submit" class="btn-icon btn-icon--muted" title="Fjern fra personlig" aria-label="Fjern fra personlig"><partial name="_Ikon" model="@("tilbakekall")" /></button>
                        </form>
                    }
                </td>
            </tr>
        }
        @foreach (var program in Model.DeltMedAlle)
        {
            var erEgen = program.OpprettetAvBehandlerId == Model.EgenBehandlerId;
            var erLikt = Model.LikteProgramIder.Contains(program.Id);
            <tr data-fane-rad="delt" data-sok="@program.Navn.ToLowerInvariant()">
                <td></td>
                <td colspan="3">@program.Navn @(erEgen ? "(ditt eget)" : "")</td>
                <td>@program.OpprettetUtc.ToString("g")</td>
                <td>
                    @if (erEgen)
                    {
                        <span class="btn-icon btn-icon--muted" title="Ditt eget — se i Personlig" aria-label="Ditt eget"><partial name="_Ikon" model="@("kalender")" /></span>
                    }
                    else if (erLikt)
                    {
                        <span class="btn-icon btn-icon--aktiv" title="Likt — se i Personlig" aria-label="Likt"><partial name="_Ikon" model="@("lik")" /></span>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Lik" style="display:inline;">
                            <input type="hidden" name="programId" value="@program.Id" />
                            <button type="submit" class="btn-icon" title="Lik" aria-label="Lik"><partial name="_Ikon" model="@("lik")" /></button>
                        </form>
                    }
                </td>
            </tr>
        }
        @foreach (var program in Model.DeltMedPartner)
        {
            var erEgen = program.OpprettetAvBehandlerId == Model.EgenBehandlerId;
            var erLikt = Model.LikteProgramIder.Contains(program.Id);
            <tr data-fane-rad="partner" data-sok="@program.Navn.ToLowerInvariant()">
                <td></td>
                <td colspan="3">@program.Navn @(erEgen ? "(ditt eget)" : "")</td>
                <td>@program.OpprettetUtc.ToString("g")</td>
                <td>
                    @if (erEgen)
                    {
                        <span class="btn-icon btn-icon--muted" title="Ditt eget — se i Personlig" aria-label="Ditt eget"><partial name="_Ikon" model="@("kalender")" /></span>
                    }
                    else if (erLikt)
                    {
                        <span class="btn-icon btn-icon--aktiv" title="Likt — se i Personlig" aria-label="Likt"><partial name="_Ikon" model="@("lik")" /></span>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Lik" style="display:inline;">
                            <input type="hidden" name="programId" value="@program.Id" />
                            <button type="submit" class="btn-icon" title="Lik" aria-label="Lik"><partial name="_Ikon" model="@("lik")" /></button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>

    <div data-fane-rad="opprett" hidden style="margin-top: 1rem;">
        <p><a href="/Behandlerportal/Programmer/Rediger" class="btn btn-accent btn-sm">+ Nytt program</a></p>
    </div>
</div>

<script src="~/js/faner.js" asp-append-version="true"></script>
<script src="~/js/flervalg.js" asp-append-version="true"></script>
