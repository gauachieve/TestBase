@page "{id:long?}"
@model TestBase.Web.Areas.Behandlerportal.Pages.Programmer.RedigerModel
@using TestBase.Web.Pages.Shared
@{
    ViewData["Title"] = Model.ProgramId is null ? "Nytt program" : "Rediger program";
    var ukedager = new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday };
    var ukedagNavn = new Dictionary<DayOfWeek, string> {
        [DayOfWeek.Monday] = "Mandag", [DayOfWeek.Tuesday] = "Tirsdag", [DayOfWeek.Wednesday] = "Onsdag",
        [DayOfWeek.Thursday] = "Torsdag", [DayOfWeek.Friday] = "Fredag", [DayOfWeek.Saturday] = "Lørdag", [DayOfWeek.Sunday] = "Søndag"
    };
    const int AntallDager = 42;
}

<h1>@(Model.ProgramId is null ? "Nytt program" : "Rediger program")</h1>

@if (Model.Lagret)
{
    <p class="rapport-status-melding">Lagret.</p>
}
@if (Model.Feilmelding is not null)
{
    <p style="color: @(Model.DropsLaast ? "#b06000" : "darkred");">@Model.Feilmelding</p>
}

<form method="post" data-disable-on-submit="Lagrer …" id="programSkjema">
    <div class="hjo-felt-gruppe">
        <label for="Navn">Navn</label>
        <input type="text" id="Navn" name="Navn" value="@Model.Navn" required style="width: 100%; max-width: 480px;" />
    </div>
    <div class="hjo-felt-gruppe">
        <label for="Forklaring">Forklaring</label>
        <textarea id="Forklaring" name="Forklaring" rows="3" style="width: 100%; max-width: 480px;">@Model.Forklaring</textarea>
    </div>
    <div class="hjo-felt-gruppe">
        <label for="StartUkedag">Programmet starter på</label>
        <select id="StartUkedag" name="StartUkedag" style="width: auto; display: inline-block;">
            @foreach (var dag in ukedager)
            {
                <option value="@dag" selected="@(Model.StartUkedag == dag)">@ukedagNavn[dag]</option>
            }
        </select>
        kl.
        @* Bugliste 2026-10-05 punkt 28: en NATIV <input type="time"> sitt AM/PM-oppsett styres av
           nettleserens/OS-ens locale, IKKE av lang-attributtet alene (bekreftet ved verifisering —
           lang="nb" endret ingenting i Chromium her). Vanlig tekstfelt med mønstervalidering
           garanterer 24-timersformat uansett miljø. *@
        <input type="text" name="StartKlokkeslett" value="@Model.StartKlokkeslett" class="program-klokkeslett-input"
               inputmode="numeric" pattern="([01][0-9]|2[0-3]):[0-5][0-9]" placeholder="09:00" title="Klokkeslett i 24-timersformat, f.eks. 09:00" />
        <p><em>Neste forekomst av denne ukedagen (norsk tid) regnes ut automatisk når programmet tildeles. "Dag 0" under er den dagen.</em></p>
    </div>

    <h2>Drops</h2>
    <p><em>Klikk på en dag for å legge til eller endre en drop den dagen. Dag 0 er programmets starttidspunkt over.</em></p>

    <div class="program-kalender" id="programKalender">
    @for (var uke = 0; uke < AntallDager / 7; uke++)
    {
        <div class="program-kalender-uke">
            <div class="program-kalender-ukenummer">Uke @(uke + 1)</div>
            <div class="program-kalender-rad">
            @for (var kol = 0; kol < 7; kol++)
            {
                var dag = uke * 7 + kol;
                <button type="button" class="program-dag-celle" data-dag="@dag">
                    <span class="program-dag-nummer">Dag @dag</span>
                    <span class="program-dag-badge" hidden></span>
                </button>
            }
            </div>
        </div>
    }
    </div>

    <div id="programDropFelterSkjult" hidden></div>

    @{
        var kumulativDag = 0;
        var eksisterendeDrops = new List<object>();
        for (var i = 0; i < Model.Drops.Count; i++)
        {
            if (i > 0) { kumulativDag += Model.Drops[i].DagerEtterForrige; }
            eksisterendeDrops.Add(new { dag = kumulativDag, fra = Model.Drops[i].FraKlokkeslett, til = Model.Drops[i].TilKlokkeslett, unngaaNatt = Model.Drops[i].UnngaaNatt, testIder = Model.Drops[i].TestIder });
        }
    }
    <script id="programEksisterendeDrops" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(eksisterendeDrops))</script>

    <dialog id="programDropDialog">
        <h2 id="programDropDialogTittel">Drop på dag 0</h2>
        <p>
            <button type="button" id="programDropAvbryt" class="hjo-btn hjo-btn-stor"><partial name="_Ikon" model="@("tilbakekall")" /><span>Avbryt</span></button>
            <button type="button" id="programDropFjern" class="hjo-btn hjo-btn-stor hjo-fjern-knapp" hidden><partial name="_Ikon" model="@("slett")" /><span>Fjern drop</span></button>
            <button type="button" id="programDropLagre" class="hjo-btn hjo-btn-stor"><partial name="_Ikon" model="@("godkjenn")" /><span>Lagre drop</span></button>
        </p>
        <div class="hjo-felt-gruppe">
            <label>Tidsvindu (fra–til, randomisert)</label>
            <input type="text" id="programDropFra" class="program-klokkeslett-input" value="09:00"
                   inputmode="numeric" pattern="([01][0-9]|2[0-3]):[0-5][0-9]" placeholder="09:00" title="Klokkeslett i 24-timersformat, f.eks. 09:00" />
            –
            <input type="text" id="programDropTil" class="program-klokkeslett-input" value="18:00"
                   inputmode="numeric" pattern="([01][0-9]|2[0-3]):[0-5][0-9]" placeholder="18:00" title="Klokkeslett i 24-timersformat, f.eks. 18:00" />
        </div>
        <div class="hjo-felt-gruppe">
            <label><input type="checkbox" id="programDropUnngaaNatt" checked /> Unngå natt (22:00–07:00)</label>
        </div>

        <partial name="_TestKategoriVelger" model="@(new TestKategoriVelgerModel { KategoriTre = Model.KategoriTre, IdPrefix = "drop" })" />
    </dialog>

    <p><button type="submit" class="btn-accent">Lagre program</button></p>
</form>

<script src="~/js/program-editor.js" asp-append-version="true"></script>
