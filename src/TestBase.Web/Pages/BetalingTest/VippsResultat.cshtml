@page
@model TestBase.Web.Pages.BetalingTest.VippsResultatModel
@{
    ViewData["Title"] = "Vipps-betalingstestresultat";
}

<h1>Vipps-betalingstestresultat</h1>
<p>Diagnostisk resultat fra en ekte Vipps-testbetaling — ikke koblet til noen ekte ordre i systemet.</p>

<p>Referanse: <code>@Model.Referanse</code></p>

@if (Model.Feil is not null)
{
    <p style="color: darkred;">Feil: @Model.Feil</p>
}
else if (Model.Status is not null)
{
    <p>Status: <strong>@(Model.Status.Success ? Model.Status.Status?.ToString() ?? "Ukjent" : $"Feilet — {Model.Status.ErrorMessage}")</strong></p>
}

<p><a href="/DevDemo">Tilbake til /DevDemo</a></p>
