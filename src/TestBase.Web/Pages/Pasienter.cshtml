@page
@model TestBase.Web.Pages.PasienterModel
@{
    ViewData["Title"] = "For pasienter";
    ViewData["BodyClass"] = "home";
    ViewData["Portal"] = "pasient";
}

<section class="hero">
    <div class="hero-shapes" aria-hidden="true">
        <div class="shape shape-blob"></div>
        <div class="shape shape-triangle shape-triangle-1"></div>
        <div class="shape shape-triangle shape-triangle-2"></div>
    </div>
    <div class="container hero-inner">
        <div class="hero-text">
            <p class="kicker">For deg som pasient</p>
            <h1>Fyll ut testen din trygt, hjemmefra</h1>
            <p class="lead">
                Har du fått en test tildelt av behandleren din? Logg inn med BankID — ingen
                passord å huske — og fyll ut i ditt eget tempo. Svarene dine lagres underveis,
                så du kan fortsette senere hvis du blir avbrutt.
            </p>
            <div class="hero-cta">
                <a class="btn btn-accent" href="/Pasientportal/Konto/LoggInn">Logg inn med BankID</a>
                <a class="btn btn-outline" href="#slik-fungerer-det">Slik fungerer det</a>
            </div>
        </div>
        <div class="hero-media">
            <img src="~/img/hero-placeholder.svg" alt="Plassholderbilde — byttes ut senere" class="hero-photo" />
        </div>
    </div>
</section>

<section id="slik-fungerer-det" class="features">
    <div class="container">
        <p class="kicker center">Slik fungerer det</p>
        <h2 class="center">Tre enkle steg</h2>
        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
                </div>
                <h3>1. Du får en invitasjon</h3>
                <p>Behandleren din sender deg en lenke på SMS eller e-post for å opprette pasientkontoen din.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l7 3v5c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6z"/></svg>
                </div>
                <h3>2. Logg inn med BankID</h3>
                <p>Ingen brukernavn eller passord — BankID bekrefter hvem du er, hver gang du logger inn.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 3v2h6V3"/><path d="M8 11h8M8 15h5"/></svg>
                </div>
                <h3>3. Fyll ut i ditt tempo</h3>
                <p>Svar side for side. Fremdriften lagres automatisk, så du kan fortsette senere.</p>
            </div>
        </div>
    </div>
</section>

<section class="features" style="padding-top:0;">
    <div class="container center">
        <p class="kicker">Har du ikke fått en invitasjon ennå?</p>
        <h2>Ta kontakt med behandleren din</h2>
        <p>Pasientkontoer opprettes av behandleren din — TestBase kan ikke opprette en konto for deg direkte.</p>
    </div>
</section>
