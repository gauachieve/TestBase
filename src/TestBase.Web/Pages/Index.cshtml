@page
@model TestBase.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Forside";
    ViewData["BodyClass"] = "home";
}

<section class="hero">
    <div class="hero-shapes" aria-hidden="true">
        <div class="shape shape-blob"></div>
        <div class="shape shape-triangle shape-triangle-1"></div>
        <div class="shape shape-triangle shape-triangle-2"></div>
    </div>
    <div class="container hero-inner">
        <div class="hero-text">
            <p class="kicker">Digital psykologisk testing</p>
            <h1>Trygg og enkel testing for dine pasienter</h1>
            <p class="lead">
                TestRom lar deg som behandler sende psykologiske tester til pasientene dine
                over nett — med automatisk skåring, oversiktlige rapporter og sikker lagring
                av helseopplysninger, uten omveien om papir.
            </p>
            <div class="hero-cta">
                <a class="btn btn-accent" href="/Konto/LoggInn">Logg inn</a>
                <a class="btn btn-outline" href="#tjenester">Les mer</a>
            </div>
        </div>
        <div class="hero-media">
            <img src="~/img/hero-intro.jpg" alt="Notatblokk og penn, klar til bruk" class="hero-photo" />
        </div>
    </div>
</section>

<section id="tjenester" class="features">
    <div class="container">
        <p class="kicker center">Hva kan TestRom hjelpe deg med</p>
        <h2 class="center">Alt du trenger for digital testing, samlet ett sted</h2>
        <div class="feature-grid">
            <a class="feature-card" href="/Funksjoner#digitale-tester">
                <div class="feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 3v2h6V3"/><path d="M8 11h8M8 15h5"/></svg>
                </div>
                <h3>Digitale tester</h3>
                <p>Tildel psykologiske tester til pasienter, som fyller dem ut trygt hjemmefra, side for side.</p>
                <span class="feature-card-mer">Les mer &rarr;</span>
            </a>
            <a class="feature-card" href="/Funksjoner#sikker-lagring">
                <div class="feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l7 3v5c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6z"/></svg>
                </div>
                <h3>Sikker lagring</h3>
                <p>Helseopplysninger og personnummer krypteres, med full tilgangsstyring og revisjonslogg.</p>
                <span class="feature-card-mer">Les mer &rarr;</span>
            </a>
            <a class="feature-card" href="/Funksjoner#automatisk-skaring">
                <div class="feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19V9M12 19V5M20 19v-7"/></svg>
                </div>
                <h3>Automatisk skåring</h3>
                <p>Svarene skåres automatisk med validerte beregningsmetoder — ingen manuell regning.</p>
                <span class="feature-card-mer">Les mer &rarr;</span>
            </a>
            <a class="feature-card" href="/Funksjoner#rapporter">
                <div class="feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="3"/><path d="M5 21c0-4 3-6 7-6s7 2 7 6"/></svg>
                </div>
                <h3>Rapporter til behandler</h3>
                <p>Se resultatet per besvarelse og utviklingen over tid, samlet i én tydelig rapport.</p>
                <span class="feature-card-mer">Les mer &rarr;</span>
            </a>
            <a class="feature-card" href="/Funksjoner#hjemmeoppgaver">
                <div class="feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                </div>
                <h3>Hjemmeoppgaver</h3>
                <p>Gi pasienten strukturerte oppgaver mellom konsultasjoner — egne, eller delt med klinikken.</p>
                <span class="feature-card-mer">Les mer &rarr;</span>
            </a>
            <a class="feature-card" href="/Funksjoner#behandlingsprogrammer">
                <div class="feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
                </div>
                <h3>Behandlingsprogrammer</h3>
                <p>Sett opp et tidsbasert forløp av tester og oppgaver som sendes ut automatisk etter en fast plan.</p>
                <span class="feature-card-mer">Les mer &rarr;</span>
            </a>
            <a class="feature-card" href="/Funksjoner#grupperapportering">
                <div class="feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="12" width="4" height="8"/><rect x="10" y="7" width="4" height="13"/><rect x="17" y="3" width="4" height="17"/></svg>
                </div>
                <h3>Grupperapportering</h3>
                <p>Se resultater for en hel gruppe pasienter samlet, med histogram og gjennomsnitt.</p>
                <span class="feature-card-mer">Les mer &rarr;</span>
            </a>
        </div>

        <ul class="unike-funksjoner">
            <li>Stort og voksende bibliotek av innebygde, ferdig skårede tester</li>
            <li>Automatiske påminnelser så pasienten faktisk fullfører testen</li>
            <li>Tidsbaserte behandlingsprogrammer som sender ut tester og oppgaver selv</li>
            <li>Støtte for klinikker/kontorfellesskap med flere behandlere</li>
        </ul>
    </div>
</section>

<section id="om" class="features" style="padding-top:0;">
    <div class="container">
        <p class="kicker center">Om TestRom</p>
        <h2 class="center">Bygget for norske behandlere</h2>
        <p class="center" style="max-width:60ch;margin:0 auto;">
            TestRom utvikles for privatpraktiserende psykologspesialister og kontorfellesskap
            i Norge, med personvern og informasjonssikkerhet (Normen/GDPR) som grunnpremiss —
            ikke noe som legges på i etterkant.
        </p>
    </div>
</section>
