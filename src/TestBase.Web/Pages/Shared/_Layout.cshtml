@using Microsoft.AspNetCore.Hosting
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Hosting
@using TestBase.Shared
@using TestBase.Shared.Data
@using TestBase.Shared.Domain.Administrasjon
@using TestBase.Shared.Domain.Tester
@using TestBase.Shared.Security
@inject ICurrentUserContext CurrentUser
@inject IWebHostEnvironment Env
@inject IConfiguration Configuration
@inject BehandlerMeldingService MeldingService
@inject TestService TestService
@inject AppDbContext Db
@{
    var erPasientPortal = (ViewData["Portal"] as string) == "pasient";
    var innloggingsUrl = erPasientPortal ? "/Pasientportal/Konto/LoggInn" : "/Konto/LoggInn";

    long BrukerId() => long.TryParse(CurrentUser.UserId.Split(':').LastOrDefault(), out var id) ? id : 0;

    var erAdmin = CurrentUser.IsAuthenticated && (CurrentUser.Role == UserRole.Administrator || CurrentUser.Role == UserRole.Superadmin || CurrentUser.Role == UserRole.Utvikler);
    var erSuperadmin = CurrentUser.IsAuthenticated && (CurrentUser.Role == UserRole.Superadmin || CurrentUser.Role == UserRole.Utvikler);
    var erBehandler = CurrentUser.IsAuthenticated && (CurrentUser.Role == UserRole.Behandler || CurrentUser.Role == UserRole.Utvikler);
    var erPasient = CurrentUser.IsAuthenticated && (CurrentUser.Role == UserRole.Pasient || CurrentUser.Role == UserRole.Utvikler);

    var antallUlesteMeldinger = erBehandler ? await MeldingService.TellUlesteAsync(BrukerId()) : 0;
    var antallUbesvarteTester = erPasient
        ? (await TestService.HentPasientSynligeTildelingerAsync(BrukerId())).Count(t => t.Status != TestTildelingStatus.Fullfort)
        : 0;

    // Test-modus-banner (se docs/beslutningslogg.md "Abonnement/subscription-system") — vises
    // KUN for en uavhengig behandler (ikke klinikk-tilknyttet) uten lagret kort.
    var behandlerITestmodus = false;
    if (erBehandler)
    {
        var innloggetBehandlerId = BrukerId();
        var behandlerRad = await Db.Behandlere.AsNoTracking()
            .Where(b => b.Id == innloggetBehandlerId)
            .Select(b => new { b.HarKortLagret, b.PartnerId })
            .FirstOrDefaultAsync();
        behandlerITestmodus = behandlerRad is { PartnerId: null, HarKortLagret: false };
    }

    // Fargeskjema per rolle (bugliste 2026-09-13 punkt 2) — se site.css sine
    // --rolle-*-variabler. Basert på CurrentUser.Role direkte (ikke de
    // Utvikler-inkluderende erX-flaggene over, som kun styrer navigasjonens
    // synlighet) slik at fargen matcher HVEM man faktisk er logget inn som.
    var rolleKlasse = CurrentUser.Role switch
    {
        UserRole.Superadmin => "rolle-superadmin",
        UserRole.Administrator => "rolle-admin",
        UserRole.Behandler => "rolle-behandler",
        UserRole.Pasient => "rolle-pasient",
        _ => null
    };
    var bodyKlasser = string.Join(' ', new[] { ViewData["BodyClass"] as string, rolleKlasse }.Where(k => !string.IsNullOrEmpty(k)));
}
<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TestRom</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@bodyKlasser">
    @if (TestBase.Web.Security.Miljo.TillatUtviklingsSnarveier(Configuration) && !CurrentUser.IsAuthenticated)
    {
        <div class="dev-bar">
            Utviklingsmiljø (@Env.EnvironmentName)
            <a href="/DevDemo">Dev-demo</a>
            <a href="/health">/health</a>
        </div>
    }
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" href="/"><svg class="brand-logo" width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="6" fill="var(--ink)" /><text x="16" y="23" font-family="-apple-system,Segoe UI,Roboto,Arial,sans-serif" font-size="17" font-weight="700" text-anchor="middle" fill="var(--accent)">TR</text></svg><span class="brand-wordmark"><span>Test</span>Rom</span></a>

            <div class="header-actions">
                @if (CurrentUser.IsAuthenticated)
                {
                    if (erAdmin && TestBase.Web.Security.Miljo.TillatUtviklingsSnarveier(Configuration))
                    {
                        <a class="nav-link" href="/Admin/Konto/ByttModus">Bytt modus</a>
                    }
                    if (CurrentUser.EktSuperadminId is not null)
                    {
                        <a class="nav-link" href="/Admin/Konto/ByttIdentitet">Bytt identitet</a>
                    }
                    <div class="bruker-omrade">
                        <span class="nav-link innlogget-som">Innlogget som: @CurrentUser.DisplayName</span>
                        <a class="btn btn-outline btn-sm" href="/Konto/LoggUt">Logg ut</a>
                    </div>
                }
                else
                {
                    <a class="btn btn-accent btn-sm" href="@innloggingsUrl">Logg inn</a>
                }
            </div>
        </div>

        @if (erAdmin || erBehandler || erPasient)
        {
            <div class="funksjons-nav">
                <div class="container funksjons-nav-inner">
                    @if (erAdmin)
                    {
                        <div class="funksjonsnav-seksjon funksjonsnav-seksjon--admin">
                            <a class="funksjonsknapp" href="/Admin/Administratorer"><partial name="_Ikon" model="@("administratorer")" />Administratorer</a>
                            <a class="funksjonsknapp" href="/Admin/Behandlere"><partial name="_Ikon" model="@("behandlere")" />Behandlere</a>
                            <a class="funksjonsknapp" href="/Admin/Pasienter"><partial name="_Ikon" model="@("pasienter")" />Pasienter</a>
                            <a class="funksjonsknapp" href="/Admin/Grupper"><partial name="_Ikon" model="@("grupper")" />Grupper</a>
                            <a class="funksjonsknapp" href="/Admin/Tester"><partial name="_Ikon" model="@("tester")" />Tester</a>
                            <a class="funksjonsknapp" href="/Admin/Tildel/Pasienter"><partial name="_Ikon" model="@("tildel")" />Tildel tester</a>
                            <a class="funksjonsknapp" href="/Admin/MinSide"><partial name="_Ikon" model="@("hus")" />Min side (admin)</a>
                            <a class="funksjonsknapp" href="/Admin/MinKonto"><partial name="_Ikon" model="@("administratorer")" />Min konto</a>
                            <a class="funksjonsknapp" href="/Admin/Tilbakemeldinger"><partial name="_Ikon" model="@("tilbakemelding")" />Tilbakemeldinger</a>
                            <a class="funksjonsknapp" href="/Admin/Programmer/Kjorende"><partial name="_Ikon" model="@("tildel")" />Kjørende programmer</a>
                            @if (erSuperadmin)
                            {
                                <a class="funksjonsknapp" href="/Admin/Partnere"><partial name="_Ikon" model="@("administratorer")" />Klinikker</a>
                                <a class="funksjonsknapp" href="/Admin/Tester/Prising"><partial name="_Ikon" model="@("tester")" />Prising</a>
                                <a class="funksjonsknapp" href="/Admin/Okonomi"><partial name="_Ikon" model="@("oppgaver")" />Økonomi</a>
                                <a class="funksjonsknapp" href="/Admin/Abonnement"><partial name="_Ikon" model="@("oppgaver")" />Abonnement</a>
                            }
                        </div>
                    }
                    @if (erBehandler)
                    {
                        <div class="funksjonsnav-seksjon funksjonsnav-seksjon--behandler">
                            <a class="funksjonsknapp" href="/Behandlerportal/MinSide">
                                <partial name="_Ikon" model="@("hus")" />Min side @(erAdmin ? "(behandler)" : "")
                                @if (antallUlesteMeldinger > 0)
                                {
                                    <span class="varsel-badge">@antallUlesteMeldinger</span>
                                }
                            </a>
                            <a class="funksjonsknapp" href="/Behandlerportal/Pasienter"><partial name="_Ikon" model="@("pasienter")" />Pasienter</a>
                            <a class="funksjonsknapp" href="/Behandlerportal/Grupper"><partial name="_Ikon" model="@("grupper")" />Grupper</a>
                            <a class="funksjonsknapp" href="/Behandlerportal/Hjemmeoppgaver"><partial name="_Ikon" model="@("hjemmeoppgave")" />Hjemmeoppgaver</a>
                            <a class="funksjonsknapp" href="/Behandlerportal/Programmer"><partial name="_Ikon" model="@("kalender")" />Programmer</a>
                            <a class="funksjonsknapp" href="/Behandlerportal/Tildel/Pasienter"><partial name="_Ikon" model="@("tildel")" />Tildel tester</a>
                            <a class="funksjonsknapp" href="/Behandlerportal/Behandlere/Inviter"><partial name="_Ikon" model="@("inviter")" />Inviter kollega</a>
                            <a class="funksjonsknapp" href="/Behandlerportal/Utbetaling"><partial name="_Ikon" model="@("oppgaver")" />Min utbetaling</a>
                            <a class="funksjonsknapp" href="/Behandlerportal/Abonnement"><partial name="_Ikon" model="@("oppgaver")" />Abonnement</a>
                            @if (CurrentUser.PartnerId is not null)
                            {
                                <a class="funksjonsknapp" href="/Behandlerportal/MinPartner/Behandlere"><partial name="_Ikon" model="@("behandlere")" />Min klinikk</a>
                            }
                        </div>
                    }
                    @if (erPasient)
                    {
                        <div class="funksjonsnav-seksjon funksjonsnav-seksjon--pasient">
                            <a class="funksjonsknapp" href="/Pasientportal/MinSide">
                                <partial name="_Ikon" model="@("hus")" />Min side @(erAdmin || erBehandler ? "(pasient)" : "")
                                @if (antallUbesvarteTester > 0)
                                {
                                    <span class="varsel-badge">@antallUbesvarteTester</span>
                                }
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </header>

    @if (behandlerITestmodus)
    {
        <div class="container">
            <p class="abonnement-banner">
                <strong>Test-modus</strong> — du har ikke lagret et betalingskort, så du kan kun sende
                tester til deg selv. <a href="/Behandlerportal/Abonnement">Sett opp abonnement &rarr;</a>
            </p>
        </div>
    }

    <main class="page@(ViewData["BredSide"] is true ? " page--bred" : "")">
        @RenderBody()
    </main>

    <footer class="site-footer">
        @if (!erPasient)
        {
            <div class="container footer-grid">
                <div>
                    <p class="footer-brand"><svg class="brand-logo" width="24" height="24" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="6" fill="#fff" fill-opacity="0.1" /><text x="16" y="23" font-family="-apple-system,Segoe UI,Roboto,Arial,sans-serif" font-size="17" font-weight="700" text-anchor="middle" fill="var(--accent)">TR</text></svg><span class="brand-wordmark"><span>Test</span>Rom</span></p>
                    <p>Online testesystem for psykologiske tester — trygg digital testing, skåring og rapportering for behandler og pasient.</p>
                </div>
                <div>
                    <h4>Logg inn</h4>
                    <a href="/Konto/LoggInn">Administrator / behandler</a>
                    <a href="/Pasienter">Pasient</a>
                </div>
                <div>
                    <h4>Om TestRom</h4>
                    <a href="/#om">Om oss</a>
                    <a href="/#tjenester">Tjenester</a>
                    <a href="/Funksjoner">Alle funksjoner</a>
                    <a href="/Prising">Priser</a>
                    <a href="/personvern">Personvern og cookies</a>
                    <a href="/salgsvilkar">Salgsvilkår</a>
                </div>
                <div>
                    <h4>Kontakt</h4>
                    <a href="mailto:gauteg@gmail.com">gauteg@gmail.com</a>
                    <a href="tel:+4790879706">+47 90 87 97 06</a>
                    <span>GGPsykolog AS</span>
                    <span>Org.nr. 913 175 492</span>
                    <span>Mølleveien 8, 1415 Oppegård</span>
                </div>
            </div>
        }
        <div class="container footer-bottom">
            <span>&copy; @DateTime.Now.Year TestRom &mdash; v@(AppVersjon.Nummer)</span>
            <span>Ingen ekte pasientdata i dette miljøet</span>
        </div>
    </footer>

    <partial name="_CookieSamtykke" />
    <partial name="_TilbakemeldingWidget" />
    <script src="~/js/validering.js" asp-append-version="true"></script>
    <script src="~/js/tabell-tall-justering.js" asp-append-version="true"></script>
</body>
</html>
