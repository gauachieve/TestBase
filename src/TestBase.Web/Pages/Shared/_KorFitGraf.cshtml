@using TestBase.Shared.Domain.Tester.Skaaring
@model KorFitGrafData
@{
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
    string F(double tall) => tall.ToString("0.##", invariant);

    // Samme begrunnelse som _UtviklingsGraf.cshtml for <text>-som-rå-streng — Razor sin egen
    // <text>-pseudo-tag tillater ikke attributter, kolliderer med SVGs <text>.
    string TekstTag(double x, double y, string cssKlasse, string ankerJustering, string innhold) =>
        $"<text x=\"{F(x)}\" y=\"{F(y)}\" class=\"{cssKlasse}\" text-anchor=\"{ankerJustering}\">{System.Net.WebUtility.HtmlEncode(innhold)}</text>";
}
<svg class="utvikling-graf kor-fit-graf" viewBox="0 0 @F(KorFitGrafBeregner.Bredde) @F(KorFitGrafBeregner.Hoyde)" role="img" aria-label="Tilbakemelding over tid">
    @* Y-akse rutenett/etiketter: fast 0/25/50/75/100 (prosent av respektive instruments maks). *@
    @foreach (var nivaa in new[] { 0, 25, 50, 75, 100 })
    {
        var y = Model.PlotTopp + (1 - nivaa / 100.0) * (Model.PlotBunn - Model.PlotTopp);
        <line x1="@F(Model.PlotVenstre)" y1="@F(y)" x2="@F(Model.PlotHoyre)" y2="@F(y)" class="utvikling-graf-rutenett" />
        @Html.Raw(TekstTag(Model.PlotVenstre - 6, y + 3, "utvikling-graf-akse-tekst", "end", $"{nivaa} %"))
    }

    @* SWLS sitt nøytrale punkt (Dieners publiserte skala-midtpunkt) — IKKE en klinisk grenseverdi. *@
    <line x1="@F(Model.PlotVenstre)" y1="@F(Model.SwlsNoytraltPunktY)" x2="@F(Model.PlotHoyre)" y2="@F(Model.SwlsNoytraltPunktY)" class="utvikling-graf-referanselinje kor-fit-cutoff-ors" />
    @Html.Raw(TekstTag(Model.PlotHoyre - 4, Model.SwlsNoytraltPunktY - 4, "utvikling-graf-akse-tekst", "end", "SWLS nøytralt punkt"))

    @* X-akse dato-etiketter for begge serier samlet. *@
    @foreach (var punkt in Model.SwlsPunkter.Concat(Model.SaiPunkter))
    {
        if (punkt.VisDatoLabel)
        {
            @Html.Raw(TekstTag(punkt.X, Model.PlotBunn + 16, "utvikling-graf-akse-tekst", "middle", punkt.DatoKort))
        }
    }

    @* SWLS-serien (livstilfredshet) — linje + punkter. *@
    <polyline points="@Model.SwlsPolylinePunkter" class="kor-fit-linje kor-fit-linje-ors" />
    @foreach (var punkt in Model.SwlsPunkter)
    {
        <circle cx="@F(punkt.X)" cy="@F(punkt.Y)" r="4" class="kor-fit-punkt kor-fit-punkt-ors">
            <title>SWLS @punkt.DatoKort: @punkt.RaaSkaar av @punkt.RaaSkaarMaks (@punkt.ProsentSkaar %)</title>
        </circle>
    }

    @* SAI-serien (allianse) — linje + punkter. *@
    <polyline points="@Model.SaiPolylinePunkter" class="kor-fit-linje kor-fit-linje-srs" />
    @foreach (var punkt in Model.SaiPunkter)
    {
        <circle cx="@F(punkt.X)" cy="@F(punkt.Y)" r="4" class="kor-fit-punkt kor-fit-punkt-srs">
            <title>SAI @punkt.DatoKort: @punkt.RaaSkaar av @punkt.RaaSkaarMaks (@punkt.ProsentSkaar %)</title>
        </circle>
    }
</svg>
<p class="kor-fit-legende">
    <span><span class="kor-fit-legende-prikk kor-fit-punkt-ors"></span> SWLS (livstilfredshet)</span>
    <span><span class="kor-fit-legende-prikk kor-fit-punkt-srs"></span> SAI (allianse)</span>
</p>
